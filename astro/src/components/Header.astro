---
const nav=[['/','首页'],['/archives/','归档'],['/gallery/','画廊'],['/about/','关于']];
---
<header class="header" transition:persist="header">
 <div class="site-brand-container"><div class="site-meta"><a href="/" class="brand journal-brand" rel="start"><img src="/images/ginka/header-logo.png" alt="GINKA" width="196" height="48"/><span>mm9527</span></a></div></div>
 <nav class="site-nav" aria-label="主导航"><ul class="main-menu menu">
 <li class="menu-item menu-item-drawer"><button type="button" data-journal-sidebar-open aria-label="打开侧栏" aria-controls="journal-sidebar" aria-expanded="false"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button></li>
 {nav.map(([href,name],i)=><li class:list={['menu-item',i===0&&'menu-item-home']}><a href={href}>{name}</a></li>)}
 <li class="menu-item menu-item-more"><details class="journal-mobile-menu"><summary>更多 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary><ul class="journal-mobile-links">{[['/tags/','标签'],['/categories/','分类'],['/library/','存档'],['/settings/','设置'],['/links/','友链']].map(([href,name])=><li class="menu-item"><a href={href}>{name}</a></li>)}</ul></details></li>
 <li class="menu-item menu-item-mode"><button type="button" data-vn-mode-toggle hidden aria-label="切换游戏与阅读模式">游戏模式</button></li>
 <li class="menu-item menu-item-theme"><button type="button" class="journal-theme-toggle" data-ginka-theme-toggle aria-label="切换主题"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg><span class="journal-theme-toggle-label">跟随系统</span></button></li>
 <li class="menu-item menu-item-search"><button type="button" class="popup-trigger" aria-label="搜索文章" aria-keyshortcuts="Control+K Meta+K"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 4 4"/></svg><span>搜索</span><kbd aria-hidden="true">Ctrl K</kbd></button></li>
 </ul></nav>
</header>
