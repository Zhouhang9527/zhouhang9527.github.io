---
import {vnScenes,sceneVars} from '../../lib/vn-scenes';
interface Props {heading:string; label:string; kind:string}
const {heading,label,kind}=Astro.props;
---
<section class="vn-stage vn-panel" data-vn-screen={kind} aria-labelledby="vn-panel-heading" style={sceneVars(vnScenes.chapter.slug,vnScenes.chapter.focal)}>
 <div class="vn-panel-inner">
  <header class="vn-panel-header"><a class="vn-return" href="/">〈 TITLE</a><div><p class="vn-kicker">{label}</p><h1 id="vn-panel-heading">{heading}</h1></div><img src={vnScenes.ui.wing} width="32" height="32" alt=""/></header>
  <div class="vn-panel-body"><slot/></div>
  <footer class="vn-panel-footer"><a href="/archives/">章节选择</a><a href="/">返回标题 〉</a></footer>
 </div>
</section>
