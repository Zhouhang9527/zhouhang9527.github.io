---
import {vnScenes,sceneVars,resolveTitleState,localTitleFrame} from '../../lib/vn-scenes';
import {href} from '../../lib/site';
import type {Post} from '../../lib/types';
interface Props {posts:Post[]}
const {posts}=Astro.props;
const background=vnScenes.title.background;
const initial=resolveTitleState(0);
const localOriginal=import.meta.env.DEV&&!!process.env.GINKA_TITLE_DATA;
const menuOriginal=localOriginal&&!!process.env.GINKA_VN_UI_DATA;
const menuStyle=(key:keyof typeof vnScenes.privateUI.titleMenu.states)=>{
 if(!menuOriginal)return undefined;
 const id=key.toLowerCase();return `--vn-normal-art:url(/__ginka_local_ui__/title-normal-${id}.png);--vn-hover-art:url(/__ginka_local_ui__/title-hover-${id}.png);--vn-pressed-art:url(/__ginka_local_ui__/title-pressed-${id}.png)`;
};
const coverStyle=sceneVars(background.slug,background.focal)+(localOriginal?`;--vn-original-frame:url('${localTitleFrame(initial.frame)}')`:'');
---
<section class="vn-stage vn-title" data-vn-title data-vn-title-menu-original={String(menuOriginal)} data-vn-title-unlocked="false" data-vn-cover={background.id} data-vn-stage={initial.id} data-vn-character-present={String(initial.present)} data-vn-expression={initial.expression??"none"} data-vn-frame={initial.frame} data-vn-original={String(localOriginal)} data-vn-frame-render={localOriginal?"original":"fallback"} data-vn-paths={JSON.stringify(posts.map(p=>href(p.data.route)))} aria-labelledby="vn-title-heading">
 <div class="vn-cover" aria-hidden="true">
  <div class="vn-cover-art" data-vn-art={background.id} style={coverStyle}></div>
  {localOriginal&&<div class="vn-original-logo" style="--vn-logo-art:url(/__ginka_local_title__/logo.png)"></div>}
 </div>
 <div class="vn-title-content">
  <div class="vn-title-menu">
   <h1 id="vn-title-heading"><img src={vnScenes.ui.logo} alt="GINKA" width="196" height="48"/><span class="journal-visually-hidden">逆向工程与二进制安全</span></h1>
   <p class="vn-kicker">MM9527 / PERSONAL ARCHIVE</p>
   <nav class="vn-menu" aria-label="标题菜单">
    <a data-vn-continue data-vn-resume href="/archives/" hidden><span style={menuStyle('CONTINUE')}>CONTINUE</span><small>继续阅读</small></a>
    <span class="vn-menu-disabled" data-vn-no-save aria-disabled="true"><span style={menuStyle('CONTINUE')}>CONTINUE</span><small>暂无阅读记录</small></span>
    <a data-vn-next href="/afterstory/" hidden><span style={menuStyle('NEXT')}>NEXT</span><small>后日谈</small></a>
    <span class="vn-menu-disabled" data-vn-no-next aria-disabled="true"><span style={menuStyle('NEXT')}>NEXT</span><small>通关后解锁</small></span>
    <a data-vn-start href="/archives/"><span style={menuStyle('START')}>START</span><small>开始阅读</small></a>
    <a href="/library/"><span style={menuStyle('LOAD')}>LOAD</span><small>读取存档</small></a>
    <a href="/settings/"><span style={menuStyle('SYSTEM')}>SYSTEM</span><small>系统设置</small></a>
    <a data-vn-extra href="/gallery/" hidden><span style={menuStyle('EXTRA')}>EXTRA</span><small>鉴赏与索引</small></a><span class="vn-menu-disabled" data-vn-no-extra aria-disabled="true"><span style={menuStyle('EXTRA')}>EXTRA</span><small>通关后解锁</small></span>
    <a href="/about/"><span style={menuStyle('INFORMATION')}>INFORMATION</span><small>关于本站</small></a>
    <a href="#latest" data-vn-mode-set="reader"><span style={menuStyle('EXIT')}>EXIT</span><small>退出游戏模式</small></a>
   </nav>
   <span class="vn-next-new" data-vn-next-new hidden style={menuOriginal?"--vn-new-art:url(/__ginka_local_ui__/title-new.png)":undefined}>NEW</span>
   <p class="vn-save-status" data-vn-progress aria-live="polite">阅读记录 0 / {posts.length}</p>
  </div>
  <div class="vn-title-tools">
   <button type="button" data-vn-fullscreen hidden>全屏</button>
   <a href="https://ginka.frontwing.jp/story/" target="_blank" rel="noopener noreferrer">©Frontwing / ©bushiroad</a>
   <span>非官方同人主题 · 预览</span>
  </div>
 </div>
</section>
