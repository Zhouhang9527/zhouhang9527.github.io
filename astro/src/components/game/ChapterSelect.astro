---
import {href,config,tagSlug,allPosts,mainlinePaths} from '../../lib/site';
import type {CollectionProps} from '../../lib/types';
type Props=CollectionProps;
const {kind,title,posts,names,page=1,totalPages=1,base='archives/'}=Astro.props;
const original=import.meta.env.DEV&&!!process.env.GINKA_VN_UI_DATA;
const available=await allPosts();
const required=new Set(mainlinePaths(available));
const years=kind==='archive'?Array.from(new Set(available.map(p=>p.data.date.slice(0,4)))):[];
---
<section class="vn-stage vn-chapter" data-vn-chapter data-vn-choice-original={String(original)} aria-labelledby="vn-chapter-heading" style={original?"--vn-choice-atlas:url(/__ginka_local_ui__/choice.png)":undefined}>
 <div class="vn-chapter-content">
  <header><a class="vn-return" href="/">← TITLE / 返回标题</a><p class="vn-kicker">CHAPTER SELECT</p><h1 id="vn-chapter-heading">{title}</h1><p>选择一篇记录，进入阅读手册。主线固定 15 篇，所有文章链接始终开放。</p></header>
  <nav class="vn-tabs" aria-label="章节索引"><a href="/archives/" aria-current={kind==='archive'?'page':undefined}>时间归档</a><a href="/tags/" aria-current={kind==='tags'?'page':undefined}>主题标签</a><a href="/categories/" aria-current={kind==='categories'?'page':undefined}>内容分类</a><a href="/library/">读取存档</a><a href="/map/">岛屿地图</a></nav>
  {years.length>0&&<nav class="vn-tabs vn-year-tabs" aria-label="年份">{years.map(year=><a href={href('archives/'+year+'/')} aria-current={base.startsWith('archives/'+year+'/')?'page':undefined}>{year}</a>)}</nav>}
  {names?<ol class="vn-choices" aria-label="主题章节">{names.map((name,i)=><li><a href={href(kind+'/'+tagSlug(name)+'/')}><span class="vn-choice-no">{String(i+1).padStart(2,'0')}</span><span class="vn-choice-title">{name}</span><span>{posts.filter(post=>post.data[kind==='categories'?'categories':'tags'].includes(name)).length} 篇</span><span class="vn-choice-arrow" aria-hidden="true">›</span></a></li>)}</ol>:<ol class="vn-choices" aria-label="文章章节">{posts.map((post,i)=><li><a data-vn-post data-vn-mainline-post={String(required.has(href(post.data.route)))} href={href(post.data.route)}><span class="vn-choice-no">{String((page-1)*config.pageSize+i+1).padStart(2,'0')}</span><span class="vn-choice-title">{post.data.title}<span class="journal-visually-hidden" data-vn-read-status> · 未读</span></span><time datetime={post.data.date}>{post.data.dateOnly}</time><span class="vn-choice-arrow" aria-hidden="true">›</span></a></li>)}</ol>}
  {totalPages>1&&<nav class="vn-tabs" aria-label="分页">{Array.from({length:totalPages},(_,i)=><a href={href(base+(i===0?'':'page/'+(i+1)+'/'))} aria-current={i+1===page?'page':undefined}>{i+1}</a>)}</nav>}
 </div>
</section>
