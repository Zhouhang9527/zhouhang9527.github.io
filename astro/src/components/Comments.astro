---
import { config } from '../lib/site';
const g = config.giscus;
const original=import.meta.env.DEV&&!!process.env.GINKA_VN_UI_DATA;
---
<section class="journal-dialogue" data-vn-backlog data-vn-backlog-original={String(original)} style={original?"--vn-backlog-base:url(/__ginka_local_ui__/backlogDark.png);--vn-log-back:url(/__ginka_local_ui__/backlogButtons-back.png);--vn-log-back-hover:url(/__ginka_local_ui__/backlogButtons-backHover.png);--vn-log-up:url(/__ginka_local_ui__/backlogAtlas-up.png);--vn-log-down:url(/__ginka_local_ui__/backlogAtlas-down.png);--vn-log-up-hover:url(/__ginka_local_ui__/backlogAtlas-upHover.png);--vn-log-down-hover:url(/__ginka_local_ui__/backlogAtlas-downHover.png);--vn-log-top:url(/__ginka_local_ui__/backlogAtlas-top.png);--vn-log-top-hover:url(/__ginka_local_ui__/backlogAtlas-topHover.png);--vn-log-end:url(/__ginka_local_ui__/backlogAtlas-end.png);--vn-log-end-hover:url(/__ginka_local_ui__/backlogAtlas-endHover.png);--vn-log-rail:url(/__ginka_local_ui__/backlogAtlas-rail.png)":undefined} aria-label="历史对话">
  <header class="vn-backlog-header"><span>BACKLOG</span><h2 id="vn-log-title">历史对话</h2><nav class="vn-backlog-controls" aria-label="历史对话导航"><button type="button" data-vn-log-scroll="top" aria-label="回到最早记录">⇈</button><button type="button" data-vn-log-scroll="up" aria-label="向上翻阅">▲</button><button type="button" data-vn-log-scroll="down" aria-label="向下翻阅">▼</button><button type="button" data-vn-log-scroll="end" aria-label="回到最新记录">⇊</button><a href="#main-content" data-vn-log-close>返回正文 〉</a></nav></header>
  <div id="journal-comments" class="journal-dialogue-comments" data-vn-log-scrollport tabindex="-1">
    <nav data-vn-log-history-tabs hidden class="vn-log-history-tabs" aria-label="历史记录类型"><button type="button" data-vn-log-tab="comments" aria-pressed="true">真实评论</button><button type="button" data-vn-log-tab="dialogue" aria-pressed="false">原作对白</button></nav>
    <div data-vn-log-panel="dialogue" hidden><div data-vn-voice-history></div></div>
    <div data-vn-log-panel="comments" class="giscus-container" data-repo={g.repo} data-repo-id={g.repoId} data-category={g.category} data-category-id={g.categoryId} data-mapping={g.mapping} data-strict={g.strict} data-reactions-enabled={g.reactions} data-emit-metadata={g.metadata} data-lang={g.lang} data-input-position={g.inputPosition} data-loading="lazy">
      <p class="journal-comments-status" role="status">评论加载中…</p>
      <noscript><a href={'https://github.com/'+g.repo+'/discussions'}>在 GitHub 查看讨论</a></noscript>
    </div>
  </div>
</section>
