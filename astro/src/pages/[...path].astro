---
import { routes } from '../lib/site';
import type { RouteProps } from '../lib/types';
import Layout from '../layouts/Layout.astro';
import Article from '../components/Article.astro';
import Collection from '../components/Collection.astro';
import StaticPage from '../components/StaticPage.astro';
type Props = RouteProps;
export async function getStaticPaths() { return routes(); }
const props = Astro.props;
const post = props.kind === 'post' ? props.post : undefined;
const title = props.kind === 'post' ? props.post.data.title : props.title;
---
<Layout title={title} description={post?.data.description} kind={props.kind} article={!!post}>
  {props.kind === 'post' ? <Article post={props.post}/> :
    props.kind === 'about' || props.kind === 'links' ? <StaticPage kind={props.kind} title={props.title}/> :
    <Collection {...props}/>}
</Layout>
