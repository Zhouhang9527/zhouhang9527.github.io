---
import Layout from '../layouts/Layout.astro';
import TitleScreen from '../components/game/TitleScreen.astro';
import {allPosts,href,tagSlug,config} from '../lib/site';
import type {Post} from '../lib/types';
const posts=await allPosts();
const art='/images/ginka/scenes/';
const scenes=[['torii-close','海上鸟居'],['beach','姬之岛海岸'],['shop-street','岛间街道']];
const topics=[['android','Android'],['windows','Windows'],['ctf','CTF 题解'],['crypto','加密算法'],['unity','Unity'],['linux','Linux']];
const filters=(p:Post)=>p.data.tags.map((s:string)=>/^(aes|rc4|xtea|tea|md5|sha|rsa|des|异或解密|加密算法)$/i.test(s)?'crypto':s.toLowerCase()).join(' ');
---
<Layout title="逆向工程与二进制安全" kind="home" home>
 <TitleScreen posts={posts}/>
 <nav class="journal-chapters" aria-label="画集章节"><div class="book-width journal-chapter-grid">{[['01','#latest','阅读笔记','NOTES','↓'],['02','/archives/','题解归档','ARCHIVE','↗'],['03','#ginka-scenes','岛影画廊','THE ISLAND','↓']].map(([n,href,name,en,arrow])=><a href={href}><span>{n}</span><strong>{name}</strong><small>{en}</small><img class="journal-chapter-wing" src="/images/ginka/butterfly.png" alt="" width="17" height="17"/><b aria-hidden="true">{arrow}</b></a>)}</div></nav>
 <div class="book-width journal-layout"><section class="journal-feed" id="latest" aria-labelledby="latest-title"><div class="journal-section-heading"><div><span class="journal-eyebrow">01 / THE JOURNAL</span><h2 id="latest-title"><img class="journal-wing" src="/images/ginka/butterfly.png" alt="" width="23" height="23"/>最新文章<span class="journal-count">{posts.length}</span></h2></div><a href="/archives/">全部归档 ↗</a></div>
 <div class="journal-filters" role="group" aria-label="按领域筛选" hidden><button type="button" aria-pressed="true" data-journal-filter="all">全部</button>{topics.filter(([key])=>posts.some(p=>filters(p).split(' ').includes(key))).map(([key,name])=><button type="button" aria-pressed="false" data-journal-filter={key}>{name}</button>)}</div><p class="journal-visually-hidden" data-filter-status aria-live="polite"></p>
 <div class="journal-entries">{posts.map((p,i)=><article class:list={['journal-entry','entry-row',i===0&&'journal-entry-latest']} data-topics={filters(p)} data-filter-only={i>=config.pageSize?'':undefined} hidden={i>=config.pageSize}><time class="journal-date" datetime={p.data.date}><span>{p.data.date.slice(5).replace('-',' / ')}</span><small>{p.data.date.slice(0,4)}</small></time><div class="journal-entry-content"><div class="journal-entry-meta">{i===0&&<span class="journal-new">LATEST</span>}<span class="journal-entry-domain">{p.data.categories[0]||''}</span></div><h3><a class="journal-entry-link" href={href(p.data.route)}>{p.data.title}</a></h3><p>{p.data.description||''}</p><div class="journal-entry-tags">{p.data.tags.slice(0,4).map(t=><a href={href('tags/'+tagSlug(t)+'/')}>#{t}</a>)}</div></div><span class="journal-entry-arrow" aria-hidden="true">→</span></article>)}</div><div class="journal-pagination">{posts.length>config.pageSize&&<a href="/page/2/">往期文章 ↗</a>}</div></section>
 <aside class="journal-aside"><section class="journal-profile"><span class="journal-eyebrow">ABOUT THE AUTHOR</span><img src="/images/avatar.png" alt="" width="58" height="58" loading="lazy"/><h2>mm9527<span>.</span></h2><p>学习逆向工程与二进制安全<br/>在这里整理实操手记与赛题</p><div class="journal-topics"><span>REVERSE</span><span>PWN</span><span>CTF</span></div><div class="journal-profile-links"><a href="https://github.com/Zhouhang9527" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></section><figure class="journal-note journal-game-note"><img class="journal-scene" src="/images/ginka/story-scene.jpg" alt="姬之岛的海面" width="1000" height="562" loading="lazy"/><figcaption><span class="journal-eyebrow">SCENE 01 / 帰郷</span><p>渡轮 · 姬之岛</p><a href="https://ginka.frontwing.jp/story/" target="_blank" rel="noopener noreferrer">游戏官网 · STORY ↗</a></figcaption></figure></aside></div>
 <section class="journal-island" id="ginka-scenes" aria-labelledby="island-title"><div class="book-width"><div class="journal-island-heading"><h2 id="island-title"><img class="journal-wing" src="/images/ginka/butterfly.png" alt="" width="22" height="22"/>岛影画廊</h2><span class="journal-island-credit">©Frontwing / ©bushiroad</span></div><ul class="journal-scene-strip" data-journal-gallery>{scenes.map(([slug,name])=><li class="journal-scene-item"><a class="journal-scene-card" data-astro-reload href={art+slug+'-day-1440.webp'} data-full-day={art+slug+'-day-1440.webp'} data-full-night={art+slug+'-night-1440.webp'} data-caption={name+' · ©Frontwing / ©bushiroad'}><img class="scene-day" src={art+slug+'-day-960.webp'} alt={name} width="2560" height="1440" loading="lazy"/><img class="scene-night" src={art+slug+'-night-960.webp'} alt="" width="2560" height="1440" loading="lazy"/><span class="journal-scene-label">{name}</span></a></li>)}</ul></div></section>
</Layout>
