---
import Layout from '../layouts/Layout.astro';
import {allPosts,href} from '../lib/site';
import {vnScenes} from '../lib/vn-scenes';
import {rectStyle,stateStyle} from '../lib/vn-control';
const posts=await allPosts();
const original=import.meta.env.DEV&&!!process.env.GINKA_VN_UI_DATA;
const geometry=vnScenes.privateUI.loadGeometry;
const control=(key:'save'|'load'|'quick'|'title'|'back'|'exit')=>original?rectStyle(geometry.controls[key],[0,0,...geometry.canvas])+';'+stateStyle(true,s=>s==='normal'||s==='hover'||s==='pressed'?'loadLabels-'+key+'-'+s:null):undefined;
const skin=original?'--vn-load-base:url(/__ginka_local_ui__/loadBase.png);--vn-load-row:url(/__ginka_local_ui__/loadRows-record.png);--vn-load-empty:url(/__ginka_local_ui__/loadRows-empty.png);--vn-load-heading:url(/__ginka_local_ui__/loadLabels-caption-load.png);--vn-save-heading:url(/__ginka_local_ui__/loadLabels-caption-save.png);--vn-quick-heading:url(/__ginka_local_ui__/loadLabels-caption-quick.png);--vn-quick-tab:url(/__ginka_local_ui__/loadLabels-quick-normal.png);--vn-quick-tab-selected:url(/__ginka_local_ui__/loadLabels-quick-pressed.png);--vn-quick-tab-hover:url(/__ginka_local_ui__/loadLabels-quick-hover.png);--vn-save-tab:url(/__ginka_local_ui__/loadLabels-save-pressed.png);--vn-load-tab-hover:url(/__ginka_local_ui__/loadLabels-load-hover.png);--vn-load-back:url(/__ginka_local_ui__/loadLabels-back-normal.png);--vn-load-back-hover:url(/__ginka_local_ui__/loadLabels-back-hover.png);--vn-load-tab:url(/__ginka_local_ui__/loadLabels-load-normal.png);--vn-load-tab-selected:url(/__ginka_local_ui__/loadLabels-load-pressed.png)':undefined;
---
<Layout title="读取存档" kind="archive" noindex>
 <section class="vn-stage vn-load" data-vn-screen="load" data-vn-ui-original={String(original)} style={skin} aria-labelledby="vn-load-title">
  <header class="vn-panel-header vn-load-header"><h1 id="vn-load-title">LOAD</h1><aside class="vn-option-help"><span>HELP WINDOW</span><p data-vn-library-help>选择阅读记录，恢复上一次的阅读位置</p></aside></header>
  <div class="vn-load-main">
   <div data-vn-library-tabs hidden>
    <nav class="vn-load-tabs" role="group" aria-label="存档类型">
     <button type="button" data-vn-save-tab data-vn-library-sprite aria-pressed="false" disabled style={control('save')}>SAVE</button>
     <button type="button" data-vn-filter="manual" data-vn-library-sprite aria-pressed="true" style={control('load')}>LOAD<span class="journal-visually-hidden">普通存档</span></button>
     <button type="button" data-vn-filter="quick" data-vn-library-sprite aria-pressed="false" style={control('quick')}>Q.LOAD<span class="journal-visually-hidden">快速存档</span></button>
    </nav>
    <nav class="vn-library-index" role="group" aria-label="博客阅读索引"><button type="button" data-vn-filter="recent" aria-pressed="false">最近阅读</button><button type="button" data-vn-filter="bookmarks" aria-pressed="false">收藏</button><button type="button" data-vn-filter="completed" aria-pressed="false">已读</button></nav>
   </div>
   <div class="vn-load-body">
    <div class="vn-save-grid vn-load-grid" data-vn-manual-grid hidden>{Array.from({length:10},(_,i)=><article class="vn-save-slot" data-vn-manual-slot={i}><button type="button" class="vn-save-link" data-vn-manual-action={i}><span class="vn-slot-thumbnail" aria-hidden="true"></span><span class="vn-slot-copy"><strong data-vn-manual-title>No Data</strong><span class="vn-load-meta"><small data-vn-manual-date></small><span data-vn-manual-status></span></span></span></button><button type="button" data-vn-manual-delete={i} hidden>删除</button></article>)}</div><p data-vn-manual-feedback role="status" class="journal-visually-hidden"></p>
    <div class="vn-save-grid vn-load-grid" data-vn-library hidden>
     {posts.map(post=><article class="vn-save-slot" data-vn-slot={href(post.data.route)} hidden><a href={href(post.data.route)} class="vn-save-link" data-vn-resume><span class="vn-slot-thumbnail" aria-hidden="true">GINKA</span><span class="vn-slot-copy"><strong>{post.data.title}</strong><span class="vn-load-meta"><small data-vn-slot-date data-published={post.data.dateOnly}>{post.data.dateOnly}</small><span data-vn-slot-status></span></span></span></a><button type="button" data-vn-bookmark aria-pressed="false" aria-label={'收藏 '+post.data.title}>收藏</button></article>)}
     {Array.from({length:10},()=> <div class="vn-load-empty-slot" data-vn-empty-slot hidden aria-label="空存档">No Data</div>)}
    </div>
    <p class="journal-visually-hidden" data-vn-library-empty hidden>暂无记录</p>
    <noscript><p>启用 JavaScript 后可以查看本机阅读记录</p><a href="/archives/">进入文章归档</a></noscript>
   </div>
   <footer class="vn-load-footer">
    <nav data-vn-library-pages data-vn-private-page-geometry={original?JSON.stringify({canvas:geometry.canvas,controls:geometry.controls}):undefined} aria-label="存档分页" hidden><button type="button" data-vn-page-step="-1" aria-label="上一页">〈</button><span data-vn-page-numbers></span><button type="button" data-vn-page-step="1" aria-label="下一页">〉</button></nav>
    <div class="vn-load-footer-links">
     <a href="/" data-vn-mode-set="game" data-vn-library-title data-vn-library-sprite style={control('title')}>TITLE</a>
     <a class="vn-return vn-load-return" href="/" data-vn-mode-set="game" data-vn-library-sprite aria-label="Back to Title" style={control('back')}>BACK</a>
     <button type="button" data-vn-save-back data-vn-library-sprite hidden style={control('back')}>返回正文</button>
     <a href="/#latest" data-vn-mode-set="reader" data-vn-library-exit data-vn-library-sprite style={control('exit')}>EXIT</a>
    </div>
   </footer>
  </div>
 </section>
</Layout>
