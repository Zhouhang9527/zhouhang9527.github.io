{
  "name": "ginka-astro",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/prepare.mjs && astro dev",
    "build": "npm run check:fonts && npm run check:reading && node tools/prepare.mjs && astro build && pagefind --site dist && node tools/metadata.mjs && node tools/verify.mjs",
    "preview": "astro preview",
    "check": "node tools/verify.mjs",
    "typecheck": "node tools/prepare.mjs && astro check",
    "check:fonts": "node --test tools/local-font.test.mjs",
    "check:reading": "node --experimental-strip-types --test tools/reading-state.test.mjs"
  },
  "dependencies": {
    "astro": "5.16.0",
    "gray-matter": "4.0.3",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fortawesome/fontawesome-free": "7.0.0",
    "pagefind": "1.4.0"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "@astrojs/check": "0.9.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0 <25"
  }
}
