{# 页面场景底图：日/夜各一张，CSS 按 data-theme 只显示其中一张。 #}
{% set slug = wash | default('panorama') %}
{% set base = '/images/ginka/scenes/' ~ slug %}
<div class="journal-page-wash" aria-hidden="true">
  <img class="scene-day" src="{{ url_for(base ~ '-day-1440.webp') }}" srcset="{{ url_for(base ~ '-day-640.webp') }} 640w, {{ url_for(base ~ '-day-960.webp') }} 960w, {{ url_for(base ~ '-day-1440.webp') }} 1440w" sizes="100vw" alt="" width="2560" height="1440" loading="lazy" decoding="async">
  <img class="scene-night" src="{{ url_for(base ~ '-night-1440.webp') }}" srcset="{{ url_for(base ~ '-night-640.webp') }} 640w, {{ url_for(base ~ '-night-960.webp') }} 960w, {{ url_for(base ~ '-night-1440.webp') }} 1440w" sizes="100vw" alt="" width="2560" height="1440" loading="lazy" decoding="async">
</div>
