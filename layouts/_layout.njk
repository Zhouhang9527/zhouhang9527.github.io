<!DOCTYPE html>
<html lang="{{ page.lang }}">
<head>
  {{ partial('_partials/head/head.njk', {}, {cache: theme.cache.enable}) }}
  {%- include '_partials/head/head-unique.njk' -%}
  <title>{% block title %}{% endblock %}</title>
  {{ partial('_third-party/analytics/index.njk', {}, {cache: theme.cache.enable}) }}
  {{ partial('_scripts/index.njk', {}, {cache: theme.cache.enable}) }}
  {{ partial('_third-party/index.njk', {}, {cache: theme.cache.enable}) }}
  {{ partial('_third-party/statistics/index.njk', {}, {cache: theme.cache.enable}) }}
  {%- include '_third-party/math/index.njk' -%}
  {%- include '_third-party/quicklink.njk' -%}
  {{- next_inject('head') }}
  <noscript>
    <link rel="stylesheet" href="{{ url_for(theme.css) }}/noscript.css">
  </noscript>
</head>

<body itemscope itemtype="http://schema.org/WebPage"{% if theme.motion.enable %} class="use-motion"{% endif %}>
  {{- next_inject('bodyBegin') }}
  <a class="journal-skip-link" href="#main-content">跳到正文</a>
  <div class="headband"></div>

  <main class="main">
    <div class="column">
      <header class="header" itemscope itemtype="http://schema.org/WPHeader">
        {%- include '_partials/header/index.njk' -%}
      </header>
      {%- if theme.sidebar.display !== 'remove' %}
        {% block sidebar %}{% endblock %}
      {%- endif %}
    </div>

    {% set drawerScene = ginka_scene(page, 'sidebar') %}
    <div id="main-content" class="main-inner {% block class %}{% endblock %}" data-sidebar-scene-day="{{ drawerScene.day }}" data-sidebar-scene-night="{{ drawerScene.night }}" data-scene-kind="{{ drawerScene.kind }}">
      {%- include '_partials/header/sub-menu.njk' -%}
      {% block content %}{% endblock %}
      {% if page.comments and theme.giscus.repo %}
        {% set dialogueSkin = ginka_dialogue_skin() %}
        <section class="journal-dialogue" aria-label="评论区">
          <div class="journal-dialogue-frame{% if dialogueSkin %} journal-dialogue-original{% endif %}{% if dialogueSkin and dialogueSkin.advance %} journal-dialogue-has-advance{% endif %}"{% if dialogueSkin %} data-dialogue-skin="original" style="--dialogue-frame:url('{{ dialogueSkin.frame }}');--dialogue-butterfly:url('{{ dialogueSkin.butterfly }}');--dialogue-line:url('{{ dialogueSkin.line }}'){% if dialogueSkin.advance %};--dialogue-advance:url('{{ dialogueSkin.advance }}'){% endif %}"{% endif %}>
            <div class="journal-dialogue-name">mm9527</div>
            <p class="journal-dialogue-intro">读到这里，有什么想说的吗？</p>
            <a class="journal-dialogue-next" href="#journal-comments" aria-label="进入评论区" title="进入评论区"><svg viewBox="0 0 16 12" width="16" height="12" aria-hidden="true" focusable="false"><path d="M2 2h12L8 10z" fill="currentColor"/></svg></a>
          </div>
          <div id="journal-comments" class="journal-dialogue-comments" tabindex="-1">
            <div class="giscus-container"
                 data-repo="{{ theme.giscus.repo | escape }}"
                 data-repo-id="{{ theme.giscus.repo_id | escape }}"
                 data-category="{{ theme.giscus.category | escape }}"
                 data-category-id="{{ theme.giscus.category_id | escape }}"
                 data-mapping="{{ theme.giscus.mapping | default('pathname') | escape }}"
                 data-strict="{{ theme.giscus.strict | default(0) }}"
                 data-reactions-enabled="{{ theme.giscus.reactions_enabled }}"
                 data-emit-metadata="{{ theme.giscus.emit_metadata }}"
                 data-lang="{{ theme.giscus.lang | escape }}"
                 data-input-position="{{ theme.giscus.input_position | escape }}"
                 data-loading="{{ theme.giscus.loading | default('lazy') }}">
              <p class="journal-comments-status" role="status">评论加载中…</p>
              <noscript><a href="https://github.com/{{ theme.giscus.repo | escape }}/discussions">在 GitHub 查看讨论</a></noscript>
            </div>
          </div>
        </section>
      {% elif page.comments %}
        {%- include '_partials/comments.njk' -%}
      {% endif %}
    </div>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      {%- include '_partials/languages.njk' -%}
      {{ partial('_partials/footer.njk', {}, {cache: theme.cache.enable}) }}
    </div>
  </footer>

  {{ partial('_partials/widgets.njk', {}, {cache: theme.cache.enable}) }}

  {{- next_inject('bodyEnd') }}

  {# ATRI Live2D is injected via bodyEnd (_data/body-end.njk). #}

  {# Music player is injected via theme config (aplayer/meting). Remove partial to avoid duplicate players. #}

</body>
</html>
