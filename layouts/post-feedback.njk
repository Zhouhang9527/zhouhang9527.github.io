{% if page.layout === 'post' %}
<section class="journal-feedback" aria-label="文章互动" data-post-path="{{ page.path | escape }}">
  <h2>这篇笔记对你有帮助吗？</h2>
  <div class="journal-feedback-actions">
    <button class="post-like-btn" type="button" aria-pressed="false"><i class="fa fa-heart" aria-hidden="true"></i><span class="like-text">点赞</span></button>
    <button class="journal-share" type="button">复制文章链接</button>
    <a href="{{ url_for('/about/') }}">反馈问题 ↗</a>
  </div>
  <p class="journal-feedback-status" role="status" aria-live="polite"></p>
</section>
{% endif %}
