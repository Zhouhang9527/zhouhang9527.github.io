{% extends '_layout.njk' %}
{% import '_macro/sidebar.njk' as sidebar_template with context %}

{% block title %}{{ page.title }} | {{ title }}{% endblock %}

{% block class %}post posts-expand{% endblock %}

{% block content %}
  <div class="journal-reading-progress" role="progressbar" aria-label="文章阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
  <div class="journal-reading-shell">
    <nav class="journal-reading-nav" aria-label="阅读导航"><a href="{{ url_for('/') }}">GINKA / mm9527</a><span>READING / 技术笔记</span><a href="{{ url_for('/archives/') }}">返回归档 ↗</a></nav>

    {{ partial('_macro/post.njk', {post: page}) }}
    {{ partial('journal-comments.njk') }}

    {% if page.toc.enable %}
      {% set journalOutline = toc(page.content, {class: 'journal-outline-list', list_number: false, max_depth: page.toc.max_depth}) %}
      {% if journalOutline.length > 1 %}
        <aside class="journal-outline" aria-label="文章章节目录" data-journal-outline>
          <p class="journal-outline-title">目录</p>
          {{ journalOutline }}
        </aside>
      {% endif %}
    {% endif %}
  </div>
{% endblock %}

{% block comments %}{% endblock %}

{% block sidebar %}
  {{ partial('journal-sidebar.njk', {display_toc: page.toc.enable}) }}
{% endblock %}
