{% extends '_layout.njk' %}
{% import '_macro/sidebar.njk' as sidebar_template with context %}
{% block title %}{{ title }} · 逆向工程与二进制安全{% endblock %}
{% block class %}index posts-expand ginka-home{% endblock %}
{% block content %}
  {% if page.current == 1 %}
  <section class="journal-hero" aria-labelledby="journal-title">
    <img class="journal-hero-art" src="{{ url_for('/images/ginka/hero-silver.webp') }}" alt="" width="1920" height="1141" fetchpriority="high" decoding="async">
    <div class="journal-hero-copy">
      <span class="journal-eyebrow journal-vertical-label">mm9527 / PERSONAL BLOG</span>
      <h2 id="journal-title" class="journal-game-title"><span>逆向工程与二进制安全</span></h2>
      <p>记录 CTF 题解、逆向分析和学习笔记。</p>
      <div class="journal-actions">
        <a class="journal-primary" href="#latest">开始阅读 <span aria-hidden="true">↗</span></a>
        <a class="journal-secondary" href="{{ url_for('/about/') }}">关于我 <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <a class="journal-hero-note" href="http://ginka.frontwing.jp/story/" target="_blank" rel="noopener noreferrer">GINKA · ©Frontwing / ©bushiroad ↗</a>
    <span class="journal-hero-edition" aria-hidden="true">銀花 / GINKA</span>
  </section>
  <nav class="journal-chapters" aria-label="首页快捷导航">
    <a href="#latest"><span>01</span><strong>阅读笔记</strong><small>NOTES</small><b aria-hidden="true">↓</b></a>
    <a href="{{ url_for('/archives/') }}"><span>02</span><strong>文章归档</strong><small>ARCHIVE</small><b aria-hidden="true">↗</b></a>
    <a href="#ginka-scenes"><span>03</span><strong>关于 GINKA</strong><small>THE ISLAND</small><b aria-hidden="true">↓</b></a>
  </nav>
  {% endif %}
  <div class="journal-layout">
    <section class="journal-feed" id="latest" aria-labelledby="latest-title">
      <div class="journal-section-heading">
        <div><span class="journal-eyebrow">THE JOURNAL</span><h2 id="latest-title">{{ '最新文章' if page.current == 1 else '往期文章' }}<span class="journal-count">{{ site.posts.length }}</span></h2></div>
        <a href="{{ url_for('/archives/') }}">全部归档 <span aria-hidden="true">↗</span></a>
      </div>
      {% for post in page.posts.toArray() %}
      <article class="journal-entry{% if loop.first and page.current == 1 %} journal-entry-featured{% endif %}">
        <div class="journal-date" aria-hidden="true"><span>{{ date(post.date, 'MM') }} / {{ date(post.date, 'DD') }}</span><small>{{ date(post.date, 'YYYY') }}</small></div>
        <div class="journal-entry-content">
        <div class="journal-entry-meta"><time datetime="{{ date(post.date, 'YYYY-MM-DD') }}">{{ date(post.date, 'YYYY.MM.DD') }}</time><span aria-hidden="true">/</span><span>{{ post.categories.first().name if post.categories.length else '学习笔记' }}</span>{% if post.sticky > 0 %}<span class="journal-pinned">置顶</span>{% endif %}</div>
        <h3><a href="{{ url_for(post.path) }}">{{ post.title | escape }}</a></h3>
        <p>{{ truncate(strip_html(post.description or post.excerpt or post.content), {length: 130, omission: '…'}) | escape }}</p>
        <div class="journal-entry-bottom"><span class="journal-entry-tags">{% for tag in post.tags.toArray().slice(0, 3) %}<a href="{{ url_for(tag.path) }}"># {{ tag.name | escape }}</a>{% else %}GINKA / 技术与记录{% endfor %}</span><a class="journal-read" href="{{ url_for(post.path) }}" aria-label="阅读全文：{{ post.title | escape }}">阅读全文 <span aria-hidden="true">→</span></a></div>
        </div>
      </article>
      {% endfor %}
      {% include '_partials/pagination.njk' %}
    </section>
    <aside class="journal-aside" aria-label="博客介绍">
      <section class="journal-profile">
        <span class="journal-eyebrow">ABOUT THE AUTHOR</span>
        <img src="{{ url_for('/images/avatar.png') }}" alt="mm9527 的头像" width="72" height="72" loading="lazy">
        <h2>mm9527<span>.</span></h2>
        <p>主要学习逆向工程与二进制安全，<br>在这里整理题解和技术笔记。</p>
        <div class="journal-topics"><span>Reverse</span><span>Pwn</span><span>CTF</span></div>
        <a class="journal-profile-link" href="{{ url_for('/archives/') }}"><strong>{{ site.posts.length }}</strong> 篇文章 <span aria-hidden="true">↗</span></a>
        <a class="journal-github" href="https://github.com/Zhouhang9527" target="_blank" rel="noopener noreferrer"><i class="fab fa-github" aria-hidden="true"></i> 在 GitHub 找到我 <span aria-hidden="true">↗</span></a>
      </section>
      <section class="journal-note journal-game-note"><img class="journal-scene" src="{{ url_for('/images/ginka/story-scene.jpg') }}" alt="GINKA 游戏中的渡轮与海面" width="1000" height="562" loading="lazy"><img class="journal-butterfly" src="{{ url_for('/images/ginka/butterfly.png') }}" alt="" width="40" height="40" loading="lazy"><span class="journal-eyebrow">SCENE 01 / 帰郷</span><p>渡轮 · 姬之岛</p><a href="http://ginka.frontwing.jp/story/" target="_blank" rel="noopener noreferrer">游戏官网 · STORY ↗</a></section>
      <a class="journal-archive-link" href="{{ url_for('/archives/') }}"><span>查看全部文章<small>ARTICLE ARCHIVE</small></span><span aria-hidden="true">↗</span></a>
    </aside>
  </div>
  {% if page.current == 1 %}
  <section class="journal-island" id="ginka-scenes" aria-labelledby="island-title">
    <div class="journal-island-heading"><span class="journal-eyebrow">GINKA / THE ISLAND</span><h2 id="island-title">关于 GINKA</h2><span class="journal-island-number" aria-hidden="true">03</span></div>
    <div class="journal-island-grid">
      <figure class="journal-island-main"><img src="{{ url_for('/images/ginka/beach.webp') }}" alt="GINKA 中的夏日海边场景" width="1280" height="720" loading="lazy"><figcaption><span>姬之岛 / 夏日海边</span><span>©Frontwing / ©bushiroad</span></figcaption></figure>
      <div class="journal-island-story"><img class="journal-island-butterfly" src="{{ url_for('/images/ginka/butterfly.png') }}" alt="" width="45" height="45" loading="lazy"><h3>银花、流星与夏日的岛屿</h3><p>银花在夏日祭后失踪。五年后，流星乘渡轮回到姬之岛，与仍是旧时模样的她重逢。</p><a href="http://ginka.frontwing.jp/story/" target="_blank" rel="noopener noreferrer">阅读官方故事介绍 <span aria-hidden="true">↗</span></a><figure><img src="{{ url_for('/images/ginka/story-street.jpg') }}" alt="GINKA 游戏中晴天下的岛屿街道" width="577" height="325" loading="lazy"><figcaption>SCENE 02 / 島の日常</figcaption></figure></div>
    </div>
  </section>
  {% endif %}
{% endblock %}
{% block sidebar %}{{ partial('journal-sidebar.njk', {display_toc: false}) }}{% endblock %}
