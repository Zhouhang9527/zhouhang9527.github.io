{% extends '_layout.njk' %}
{% block title %}{{ title }} · 逆向工程与二进制安全{% endblock %}
{% block class %}index posts-expand ginka-home{% endblock %}
{% block content %}
{% set cover = page.current == 1 %}
{% set index = ginka_journal_index(page.posts, site.posts, cover) %}
{% set official = 'http://ginka.frontwing.jp/story/' %}
{% set repo = config.ginka_re_md_url | default('https://github.com/Zhouhang9527/re_md', true) %}
{% if cover %}
  <section class="journal-hero" aria-labelledby="journal-title">
    <div class="journal-hero-image" aria-hidden="true">
      <img class="hero-art journal-hero-art" src="{{ url_for('/images/ginka/hero-silver.webp') }}" srcset="{{ ginka_journal_srcset('/images/ginka/hero-silver.webp') }}" sizes="100vw" alt="" width="1920" height="1141" loading="eager" fetchpriority="high" decoding="async">
    </div>
    <span class="journal-hero-light" aria-hidden="true"></span>
    <div class="journal-hero-dust" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
    <div class="book-width journal-hero-inner">
      <div class="journal-hero-copy">
        <span class="journal-eyebrow journal-hero-kicker">MM9527 · PERSONAL ARCHIVE</span>
        <h1 id="journal-title" class="journal-game-title"><span class="journal-title-mask"><span>逆向工程</span></span><span class="journal-title-mask"><span>与二进制安全</span></span></h1>
        <p>记录 Android 加固脱壳、Windows 底层机制与 CTF 逆向分析的实操手记。</p>
        <div class="journal-actions">
          <a class="journal-primary btn-art-primary" href="#latest"><span>开始阅读</span><span aria-hidden="true">↗</span></a>
          <a class="journal-secondary" href="{{ url_for('/about/') }}">关于作者 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
    <div class="book-width journal-hero-colophon">
      <a class="journal-scroll-cue" href="#latest" aria-label="向下滚动到最新文章">SCROLL</a>
      <a class="journal-hero-note" href="{{ official }}" target="_blank" rel="noopener noreferrer">GINKA · ©Frontwing / ©bushiroad ↗</a>
    </div>
  </section>
  <nav class="journal-chapters" aria-label="画集章节">
    <div class="book-width journal-chapter-grid">
      {% set chapters = [
        {number: '01', href: '#latest', name: '阅读笔记', en: 'NOTES', arrow: '↓'},
        {number: '02', href: url_for('/archives/'), name: '题解归档', en: 'ARCHIVE', arrow: '↗'},
        {number: '03', href: '#ginka-scenes', name: '岛影画廊', en: 'THE ISLAND', arrow: '↓'}
      ] %}
      {% for chapter in chapters %}
      <a href="{{ chapter.href }}"><span>{{ chapter.number }}</span><strong>{{ chapter.name }}</strong><small>{{ chapter.en }}</small><img class="journal-chapter-wing" src="{{ url_for('/images/ginka/butterfly.png') }}" alt="" width="17" height="17" decoding="async"><b aria-hidden="true">{{ chapter.arrow }}</b></a>
      {% endfor %}
    </div>
  </nav>
{% endif %}
  <div class="book-width journal-layout">
    <section class="journal-feed" id="latest" aria-labelledby="latest-title">
      <div class="journal-section-heading">
        <div>
          <span class="journal-eyebrow">01 / THE JOURNAL</span>
          <h2 id="latest-title"><img class="journal-wing" src="{{ url_for('/images/ginka/butterfly.png') }}" alt="" width="23" height="23">{{ '最新文章' if cover else '往期文章' }}<span class="journal-count">{{ site.posts.length }}</span></h2>
        </div>
        <a href="{{ url_for('/archives/') }}">全部归档 <span aria-hidden="true">↗</span></a>
      </div>
      {% if cover and index.topics.length %}
      <div class="journal-filters" role="group" aria-label="按领域筛选" hidden>
        <button type="button" aria-pressed="true" data-journal-filter="all">全部</button>
        {% for topic in index.topics %}<button type="button" aria-pressed="false" data-journal-filter="{{ topic.key }}">{{ topic.name }}</button>{% endfor %}
      </div>
      <p class="journal-visually-hidden" data-filter-status aria-live="polite"></p>
      {% endif %}
      <div class="journal-entries">
        {% for row in index.rows %}
          {% set post = row.post %}
          <article class="journal-entry entry-row{% if post.sticky > 0 or post.featured %} journal-entry-featured{% elif row.latest %} journal-entry-latest{% endif %}" data-topics="{{ row.filters }}"{% if not row.defaultVisible %} data-filter-only hidden{% endif %}>
            <time class="journal-date" datetime="{{ date(post.date, 'YYYY-MM-DD') }}"><span>{{ date(post.date, 'MM / DD') }}</span><small>{{ date(post.date, 'YYYY') }}</small></time>
            <div class="journal-entry-content">
              {% if post.sticky > 0 or post.featured or row.latest or row.domain %}
              <div class="journal-entry-meta">
                {% if post.sticky > 0 %}<span class="journal-pinned">置顶</span>{% elif post.featured %}<span class="journal-pinned">精选</span>{% elif row.latest %}<span class="journal-new">LATEST</span>{% endif %}
                {% if row.domain %}<span class="journal-entry-domain">{{ row.domain | escape }}</span>{% endif %}
              </div>
              {% endif %}
              <h3><a class="journal-entry-link" href="{{ url_for(post.path) }}">{{ post.title | escape }}</a></h3>
              <p>{{ truncate(strip_html(post.description or post.excerpt or post.content), {length: 130, omission: '…'}) | escape }}</p>
              {% if row.tags.length %}<div class="journal-entry-tags">{% for tag in row.tags %}<a href="{{ url_for(tag.path) }}">#{{ tag.name | escape }}</a>{% endfor %}</div>{% endif %}
            </div>
            <span class="journal-entry-arrow" aria-hidden="true">→</span>
          </article>
        {% endfor %}
      </div>
      <div class="journal-pagination">{% include '_partials/pagination.njk' %}</div>
    </section>
    <aside class="journal-aside" aria-label="作者与姬之岛">
      <section class="journal-profile" aria-labelledby="journal-author">
        <span class="journal-eyebrow">ABOUT THE AUTHOR</span>
        <img src="{{ url_for('/images/avatar.png') }}" alt="" width="58" height="58" loading="lazy" decoding="async">
        <h2 id="journal-author">mm9527<span>.</span></h2>
        <p>学习逆向工程与二进制安全。<br>在这里整理实操手记与赛题。</p>
        <div class="journal-topics"><span>REVERSE</span><span>PWN</span><span>CTF</span></div>
        <div class="journal-profile-links">
          <a href="https://github.com/Zhouhang9527" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          <a href="{{ repo }}" target="_blank" rel="noopener noreferrer">re_md <span aria-hidden="true">↗</span></a>
        </div>
      </section>
      <figure class="journal-note journal-game-note">
        <img class="journal-scene" src="{{ url_for('/images/ginka/story-scene.jpg') }}" srcset="{{ ginka_journal_srcset('/images/ginka/story-scene.jpg') }}" sizes="(max-width: 960px) calc(100vw - 60px), 248px" alt="夕阳照亮渡轮甲板，远处是姬之岛的海面" width="1000" height="562" loading="lazy" decoding="async">
        <figcaption><span class="journal-eyebrow">SCENE 01 / <span lang="ja">帰郷</span></span><p>渡轮 · 姬之岛</p><a href="{{ official }}" target="_blank" rel="noopener noreferrer">游戏官网 · STORY ↗</a></figcaption>
      </figure>
    </aside>
  </div>
{% if cover %}
  {% set plates = [
    {src: '/images/ginka/reunion.webp', thumb: '/images/ginka/responsive/reunion-320.webp', number: '01', title: '重逢 · 归乡', alt: '逆光下，银花与流星重逢。', width: 1280, height: 720},
    {src: '/images/ginka/story-torii.jpg', thumb: '/images/ginka/responsive/story-torii-320.webp', number: '02', title: '夏空 · 鸟居', alt: '晴夏的海面上，朱红色鸟居依次延向天际。', width: 1000, height: 562},
    {src: '/images/ginka/story-street.jpg', thumb: '/images/ginka/responsive/story-street-320.webp', number: '03', title: '岛之日常', alt: '白云下的岛间街道、木屋与蓝色门檐。', width: 577, height: 325}
  ] %}
  <section class="journal-island" id="ginka-scenes" aria-labelledby="island-title">
    <div class="book-width">
      <div class="journal-island-heading">
        <span class="journal-eyebrow">03 / GINKA · THE ISLAND</span>
        <h2 id="island-title"><img class="journal-wing" src="{{ url_for('/images/ginka/butterfly.png') }}" alt="" width="24" height="24">岛影画廊</h2>
        <span class="journal-island-number" aria-hidden="true">03</span>
      </div>
      <div class="journal-island-grid" data-journal-gallery>
        <figure class="journal-island-main art-mat">
          <div class="art-viewport">
            {% for plate in plates %}
            <a class="art-slide{% if loop.first %} is-active{% endif %}" href="{{ url_for(plate.src) }}" data-fancybox="ginka-island" data-caption="PLATE {{ plate.number }} · {{ plate.title }} · ©Frontwing / ©bushiroad" data-plate="{{ plate.number }}" data-plate-title="{{ plate.title }}"{% if not loop.first %} aria-hidden="true" tabindex="-1"{% endif %}>
              <img src="{{ url_for(plate.src) }}" srcset="{{ ginka_journal_srcset(plate.src) }}" sizes="(max-width: 960px) 90vw, 630px" alt="{{ plate.alt }}" width="{{ plate.width }}" height="{{ plate.height }}" loading="lazy" decoding="async">
            </a>
            {% endfor %}
          </div>
          <figcaption><span class="art-caption" aria-live="polite">PLATE 01 · 重逢 · 归乡</span><span>©Frontwing / ©bushiroad</span></figcaption>
        </figure>
        <div class="journal-island-story">
          <span class="journal-eyebrow" lang="ja">姫之島で、もう一度</span>
          <h3>银花、流星与夏日的岛屿</h3>
          <p>夏日祭那一夜，银花从岛上消失了。五年后，青羽流星乘渡轮回到姬之岛，在熟悉的风景里，与模样依旧的她重逢。</p>
          <a class="journal-story-link" href="{{ official }}" target="_blank" rel="noopener noreferrer">阅读官方故事介绍 <span aria-hidden="true">↗</span></a>
          <div class="journal-plates" role="group" aria-label="选择岛影画幅">
            <span class="journal-eyebrow">SELECT PLATE · 切换画集场景</span>
            <div class="plate-list">
              {% for plate in plates %}
              <a class="plate-thumb" href="{{ url_for(plate.src) }}" data-plate-select="{{ plate.number }}"{% if loop.first %} aria-current="true"{% endif %}>
                <img src="{{ url_for(plate.thumb) }}" alt="" width="320" height="180" loading="lazy" decoding="async">
                <span><small>PLATE {{ plate.number }}</small>{{ plate.title }}</span>
              </a>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
{% endif %}
{% endblock %}
{% block sidebar %}{{ partial('journal-sidebar.njk', {display_toc: false}) }}{% endblock %}
