<!DOCTYPE html>
<html lang="{{ page.lang }}">
<head>
  {{ partial('_partials/head/head.njk', {}, {cache: theme.cache.enable}) }}
  {%- include '_partials/head/head-unique.njk' -%}
  <title>{% block title %}{% endblock %}</title>
  {{ partial('_third-party/analytics/index.njk', {}, {cache: theme.cache.enable}) }}
  {{ partial('_scripts/index.njk', {}, {cache: theme.cache.enable}) }}
  {{ partial('_third-party/index.njk', {}, {cache: theme.cache.enable}) }}
  {{ partial('_third-party/statistics/index.njk', {}, {cache: theme.cache.enable}) }}
  {%- include '_third-party/math/index.njk' -%}
  {%- include '_third-party/quicklink.njk' -%}
  {{- next_inject('head') }}
  <noscript>
    <link rel="stylesheet" href="{{ url_for(theme.css) }}/noscript.css">
  </noscript>
</head>

<body itemscope itemtype="http://schema.org/WebPage"{% if theme.motion.enable %} class="use-motion"{% endif %}>
  {{- next_inject('bodyBegin') }}
  <a class="journal-skip-link" href="#main-content">跳到正文</a>
  <div class="headband"></div>

  <main class="main">
    <div class="column">
      <header class="header" itemscope itemtype="http://schema.org/WPHeader">
        {%- include '_partials/header/index.njk' -%}
      </header>
      {%- if theme.sidebar.display !== 'remove' %}
        {% block sidebar %}{% endblock %}
      {%- endif %}
    </div>

    <div id="main-content" class="main-inner {% block class %}{% endblock %}">
      {%- include '_partials/header/sub-menu.njk' -%}
      {% block content %}{% endblock %}
      {# 原作对话框框体：本地预览素材存在时启用，生产构建自动回退为普通容器 #}
      {% set ginkaDialogue = ginka_dialogue_skin() %}
      {% if page.comments %}
        <section class="journal-dialogue" aria-labelledby="journal-dialogue-title">
          <header class="journal-dialogue-heading">
            <span class="journal-dialogue-eyebrow">AFTER STORY / 余谈</span>
            <h2 id="journal-dialogue-title">岛间来信</h2>
          </header>
          <div class="journal-dialogue-frame{% if ginkaDialogue %} journal-dialogue-original{% endif %}"{% if ginkaDialogue %} data-dialogue-skin="original" style="--dialogue-frame:url('{{ ginkaDialogue.frame }}');--dialogue-butterfly:url('{{ ginkaDialogue.butterfly }}');--dialogue-line:url('{{ ginkaDialogue.line }}')"{% endif %}>
            <span class="journal-dialogue-name">GINKA / mm9527</span>
            <p class="journal-dialogue-intro">读到这里，有什么想说的吗？</p>
            {%- include '_partials/comments.njk' -%}
          </div>
        </section>
      {% else %}
        {%- include '_partials/comments.njk' -%}
      {% endif %}
    </div>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      {%- include '_partials/languages.njk' -%}
      {{ partial('_partials/footer.njk', {}, {cache: theme.cache.enable}) }}
    </div>
  </footer>

  {{ partial('_partials/widgets.njk', {}, {cache: theme.cache.enable}) }}

  {{- next_inject('bodyEnd') }}

  {# ATRI Live2D is injected via bodyEnd (_data/body-end.njk). #}

  {# Music player is injected via theme config (aplayer/meting). Remove partial to avoid duplicate players. #}

</body>
</html>
