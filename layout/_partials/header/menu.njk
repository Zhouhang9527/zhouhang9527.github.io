{% import 'menu-item.njk' as menu_item with context %}
<nav class="site-nav" aria-label="主导航">
  <ul class="main-menu menu">
    <li class="menu-item menu-item-drawer"><button type="button" data-journal-sidebar-open aria-label="打开侧栏" aria-controls="journal-sidebar" aria-expanded="false"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button></li>
    <li class="menu-item menu-item-home"><a href="{{ config.root }}" rel="start">首页</a></li>
    <li class="menu-item menu-item-archives"><a href="{{ url_for('/archives/') }}" rel="section">归档</a></li>
    <li class="menu-item menu-item-gallery"><a href="{{ config.root }}#ginka-scenes">画廊</a></li>
    <li class="menu-item menu-item-about"><a href="{{ url_for('/about/') }}" rel="section">关于</a></li>
    <li class="menu-item menu-item-more">
      <details class="journal-mobile-menu">
        <summary>更多 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg></summary>
        <ul class="journal-mobile-links">
          {% for node in theme.main_menu %}
            {% if node.name in ['tags', 'categories', 'links', '友链'] %}{{ menu_item.render(node) | trim }}{% endif %}
          {% endfor %}
        </ul>
      </details>
    </li>
    <li class="menu-item menu-item-theme">
      <button type="button" class="journal-theme-toggle" data-ginka-theme-toggle aria-label="切换主题">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
        <span class="journal-theme-toggle-label">跟随系统</span>
      </button>
    </li>
    {% if theme.algolia_search.enable or theme.local_search.enable %}
    <li class="menu-item menu-item-search">
      <button type="button" class="popup-trigger" aria-label="搜索文章" aria-keyshortcuts="Control+K Meta+K">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 4 4"/></svg>
        <span>搜索</span><kbd aria-hidden="true">Ctrl K</kbd>
      </button>
    </li>
    {% endif %}
  </ul>
</nav>
