{# Project styles load in cascade order; font downloads never block text. #}
{% set style_sheets = ['editorial', 'pages', 'reading', 'runtime', 'motion'] %}
{% for name in style_sheets %}
  {% set style_path = 'css/ginka-' ~ name ~ '.css' %}
  <link rel="stylesheet" href="{{ ginka_asset(style_path) if ginka_asset is defined else config.root ~ style_path }}">
{% endfor %}
{# Hexo also processes data templates without the theme's url_for helper. #}
<link rel="preload" as="style" href="{{ config.root }}vendor/fonts/noto-serif-sc/wght.css" onload="this.onload=null;this.rel='stylesheet'">
<link rel="preload" as="style" href="{{ config.root }}vendor/fonts/jetbrains-mono/wght.css" onload="this.onload=null;this.rel='stylesheet'">
<noscript>
  <link rel="stylesheet" href="{{ config.root }}vendor/fonts/noto-serif-sc/wght.css">
  <link rel="stylesheet" href="{{ config.root }}vendor/fonts/jetbrains-mono/wght.css">
</noscript>

<link rel="preload" href="{{ config.root }}images/ginka/header-logo.png" as="image">
<link rel="manifest" href="{{ config.root }}manifest.webmanifest">
{% if config.ginka_music and config.ginka_music.online and config.ginka_music.online.enabled %}
<link rel="preconnect" href="{{ config.ginka_music.online.api_base }}" crossorigin>
{% endif %}

{# Page-specific Open Graph and Twitter metadata are generated by NexT. #}
{% if is_home is defined and is_home() %}
<meta property="og:image" content="{{ config.url }}/images/avatar.png">
<meta name="twitter:image" content="{{ config.url }}/images/avatar.png">
{% endif %}
<meta name="robots" content="index, follow">
<meta name="googlebot" content="index, follow">
<meta name="baiduspider" content="index, follow">
<meta name="author" content="mm9527">
<meta name="copyright" content="mm9527">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="GINKA">
<meta name="format-detection" content="telephone=no">
<meta name="theme-color" content="#f3f6fa">
<meta name="msapplication-TileColor" content="#f3f6fa">
<meta name="color-scheme" content="light">
<meta name="ginka-api-base" content="{{ theme.ginka_backend.api_base | default('') }}">
