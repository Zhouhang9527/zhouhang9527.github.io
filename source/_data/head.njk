{# Custom head injection #}
<link rel="stylesheet" href="{{ ginka_asset('css/ginka-editorial.css') if ginka_asset is defined else config.root ~ 'css/ginka-editorial.css' }}">
<link rel="stylesheet" href="{{ ginka_asset('css/ginka-pages.css') if ginka_asset is defined else config.root ~ 'css/ginka-pages.css' }}">
<link rel="stylesheet" href="{{ ginka_asset('css/ginka-runtime.css') if ginka_asset is defined else config.root ~ 'css/ginka-runtime.css' }}">
<link rel="preload" href="{{ config.root }}images/ginka/header-logo.png" as="image">

<!-- SEO 和性能优化增强 -->

<!-- 预加载关键资源 -->
<link rel="preload" href="/js/next-boot.js" as="script">
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
{% if config.ginka_music and config.ginka_music.online and config.ginka_music.online.enabled %}
<link rel="preconnect" href="{{ config.ginka_music.online.api_base }}" crossorigin>
{% endif %}

<!-- DNS预解析 -->
<link rel="dns-prefetch" href="//cdn.jsdelivr.net">
<link rel="dns-prefetch" href="//fonts.googleapis.com">

{# Page-specific Open Graph and Twitter metadata are generated by NexT. #}
{% if is_home is defined and is_home() %}
<meta property="og:image" content="{{ config.url }}/images/avatar.png">
<meta name="twitter:image" content="{{ config.url }}/images/avatar.png">
{% endif %}

<!-- 搜索引擎优化 -->
<meta name="robots" content="index, follow">
<meta name="googlebot" content="index, follow">
<meta name="baiduspider" content="index, follow">
<meta name="author" content="mm9527">
<meta name="copyright" content="mm9527">

<!-- 移动端优化 -->
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="GINKA">
<meta name="format-detection" content="telephone=no">

<!-- 主题色 -->
<meta name="theme-color" content="#37c6c0">
<meta name="msapplication-TileColor" content="#37c6c0">
<meta name="ginka-api-base" content="{{ theme.ginka_backend.api_base | default('') }}">

<!-- 结构化数据 (JSON-LD) -->
<script type="application/ld+json" data-ginka-page-meta>
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "mm9527 的博客 · GINKA",
  "description": "专注于逆向工程和二进制安全研究",
  "url": "{{ config.url }}",
  "author": {
    "@type": "Person",
    "name": "mm9527",
    "email": "3050055132@qq.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "GINKA",
    "logo": {
      "@type": "ImageObject",
      "url": "{{ config.url }}/images/avatar.png"
    }
  },
  "inLanguage": "zh-CN",
  "keywords": ["CTF", "Reverse Engineering", "Pwn", "Binary Security", "IDA Pro"]
}
</script>

