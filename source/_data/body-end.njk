<script>
(function() {
  // 移动端禁用自定义右键菜单逻辑
  if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) || 
      (window.matchMedia && window.matchMedia('(hover: none) and (pointer: coarse)').matches)) {
    return;
  }

  const contextMenu = document.getElementById('custom-context-menu');
  
  // 智能右键菜单控制
  document.addEventListener('contextmenu', (e) => {
    // 全站右键都使用自定义菜单
    e.preventDefault();
    
    // 显示自定义菜单（紧贴光标，稍微偏移5px）
    contextMenu.style.display = 'block';
    
    // 先设置初始位置
    let menuX = e.clientX + 5;
    let menuY = e.clientY + 5;
    
    // 临时显示以获取尺寸
    contextMenu.style.left = menuX + 'px';
    contextMenu.style.top = menuY + 'px';
    
    // 确保菜单不超出视口
    requestAnimationFrame(() => {
      const rect = contextMenu.getBoundingClientRect();
      
      // 如果右边超出，则显示在光标左边
      if (rect.right > window.innerWidth) {
        menuX = e.clientX - rect.width - 5;
      }
      
      // 如果下边超出，则显示在光标上方
      if (rect.bottom > window.innerHeight) {
        menuY = e.clientY - rect.height - 5;
      }
      
      // 确保不超出左边和上边
      menuX = Math.max(5, menuX);
      menuY = Math.max(5, menuY);
      
      contextMenu.style.left = menuX + 'px';
      contextMenu.style.top = menuY + 'px';
    });
    
    // ATRI 提示
    if (window.ATRI && Math.random() < 0.3) {
      window.ATRI.showMessage('打开菜单啦~', 2000);
    }
  });
  
  // 点击其他地方关闭菜单
  document.addEventListener('click', () => {
    contextMenu.style.display = 'none';
  });
  
  // 菜单项点击事件
  contextMenu.querySelectorAll('.context-menu-item').forEach(item => {
    item.addEventListener('click', (e) => {
      e.stopPropagation();
      const action = item.getAttribute('data-action');
      
      switch(action) {
        case 'back':
          window.history.back();
          break;
        case 'forward':
          window.history.forward();
          break;
        case 'refresh':
          window.location.reload();
          break;
        case 'home':
          (function() {
            const url = (window.CONFIG && window.CONFIG.root) ? window.CONFIG.root : '/';
            try {
              if (window.pjax && typeof window.pjax.loadUrl === 'function') {
                window.pjax.loadUrl(url);
                return;
              }
            } catch (_) {}
            window.location.href = url;
          })();
          break;
        case 'top':
          window.scrollTo({ top: 0, behavior: 'smooth' });
          break;
        case 'atri':
          if (window.ATRI) {
            // 右键菜单“打招呼”优先用语音回应（仍会显示字幕）
            const categories = (window.ATRI.voiceConfig && window.ATRI.voiceConfig.categories) ? window.ATRI.voiceConfig.categories : {};
            const preferred = ['welcome', 'greet', 'hello', 'menu'];
            let picked = '';
            for (const key of preferred) {
              if (categories && categories[key] && categories[key].length) {
                picked = key;
                break;
              }
            }

            const hour = new Date().getHours();
            // 右键打招呼同样：允许通用问候，只过滤“错时问候”
            const greetingFilter = (() => {
              const rx = {
                morning: /(早上|早安|morning|おはよう)/i,
                noon: /(中午|午安|noon|lunch)/i,
                afternoon: /(下午|afternoon)/i,
                evening: /(晚上|晚好|evening|こんばんは)/i,
                night: /(夜深|深夜|夜晚|晚安|night|おやすみ)/i
              };

              let allow = ['morning'];
              if (hour >= 12 && hour < 14) allow = ['noon'];
              else if (hour >= 14 && hour < 18) allow = ['afternoon'];
              else if (hour >= 18 && hour < 22) allow = ['evening', 'night'];
              else if (hour >= 22 || hour < 5) allow = ['night'];
              else if (hour >= 5 && hour < 12) allow = ['morning'];

              const banned = Object.keys(rx)
                .filter((k) => allow.indexOf(k) === -1)
                .map((k) => rx[k]);

              return (voice) => {
                const t = ((voice && voice.text) ? String(voice.text) : '') + ' ' + ((voice && voice.ja) ? String(voice.ja) : '');
                for (const r of banned) {
                  if (r.test(t)) return false;
                }
                return true;
              };
            })();

            let replied = false;
            if (picked && typeof window.ATRI.playVoice === 'function') {
              replied = !!window.ATRI.playVoice(picked, {
                filter: greetingFilter
              });
            }

            if (replied) break;

            // 兜底：语音配置未加载 / 分类不存在 / 筛选后无匹配语音时，至少给一句文字回应
            const greetings = [
              '你好呀！有什么需要帮助的吗？',
              '我在这里哦~',
              '嘿嘿，找我有什么事吗？',
              '欢迎光临！',
              '今天也要加油哦！'
            ];
            window.ATRI.showMessage(greetings[Math.floor(Math.random() * greetings.length)], 3000);
            window.ATRI.playRandomMotion();
          }
          break;
        case 'music':
          const toggleBtn = document.getElementById('music-toggle');
          if (toggleBtn) {
            toggleBtn.click();
          }
          break;
      }
      
      contextMenu.style.display = 'none';
    });
  });
  
  // 滚动时隐藏菜单
  let scrollTimer;
  window.addEventListener('scroll', () => {
    if (contextMenu.style.display === 'block') {
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => {
        contextMenu.style.display = 'none';
      }, 100);
    }
  });
})();
</script>

<!-- 移动端菜单强制修复脚本 v3 -->
<script>
(function() {
  let isFixing = false;
  
  function fixMobileMenu() {
    if (window.innerWidth > 768 || isFixing) return;
    isFixing = true;
    
    requestAnimationFrame(() => {
      // 1. 强制显示导航容器
      const siteNav = document.querySelector('.site-nav');
      if (siteNav) {
        siteNav.style.setProperty('display', 'block', 'important');
        siteNav.style.setProperty('opacity', '1', 'important');
        siteNav.style.setProperty('visibility', 'visible', 'important');
        siteNav.style.setProperty('height', 'auto', 'important');
        siteNav.style.setProperty('background', '#fff', 'important');
        siteNav.style.setProperty('padding', '10px 0', 'important');
        siteNav.style.setProperty('pointer-events', 'auto', 'important'); // 确保可点击
      }
      
      // 2. 强制显示菜单列表
      const menu = document.querySelector('.menu');
      if (menu) {
        menu.style.setProperty('display', 'flex', 'important');
        menu.style.setProperty('flex-wrap', 'wrap', 'important');
        menu.style.setProperty('justify-content', 'center', 'important');
        menu.style.setProperty('background', 'transparent', 'important');
        menu.style.setProperty('margin', '0', 'important');
        menu.style.setProperty('padding', '0', 'important');
        menu.style.setProperty('pointer-events', 'auto', 'important');
        
        // 3. 强制显示所有菜单项并修复点击
        const items = menu.querySelectorAll('.menu-item');
        items.forEach(item => {
          item.style.setProperty('display', 'inline-block', 'important');
          item.style.setProperty('margin', '0 5px', 'important');
          item.style.setProperty('pointer-events', 'auto', 'important');
          
          const link = item.querySelector('a');
          if (link) {
            link.style.setProperty('color', '#333', 'important');
            link.style.setProperty('font-size', '14px', 'important');
            link.style.setProperty('display', 'inline-block', 'important');
            link.style.setProperty('pointer-events', 'auto', 'important');
            link.style.setProperty('cursor', 'pointer', 'important');
            
            // 移除可能阻止点击的事件监听器（通过克隆节点）
            // 注意：这会移除所有事件，包括主题的 AJAX 加载，但能保证跳转
            if (!link.dataset.fixedClick) {
                link.dataset.fixedClick = "true";
                link.addEventListener('click', function(e) {
                    e.stopPropagation(); // 阻止冒泡给主题JS
                    // 如果没有 href 或者 href 是 #，则不处理
                    const href = this.getAttribute('href');
                    if (href && href !== '#' && !href.startsWith('javascript:')) {
                        window.location.href = href;
                    }
                }, true); // 捕获阶段执行
            }
          }
        });
      }

      // 4. 强制显示站点标题区域
      const brand = document.querySelector('.site-brand-container');
      if (brand) {
        brand.style.setProperty('display', 'block', 'important');
        brand.style.setProperty('opacity', '1', 'important');
        brand.style.setProperty('visibility', 'visible', 'important');
        brand.style.setProperty('pointer-events', 'auto', 'important');
        const title = brand.querySelector('.site-title');
        if (title) title.style.setProperty('color', '#333', 'important');
      }
      
      // 5. 确保头部容器不被隐藏
      const header = document.querySelector('.header');
      const headerInner = document.querySelector('.header-inner');
      if (header) {
          header.style.setProperty('z-index', '99', 'important');
          header.style.setProperty('background', '#fff', 'important');
          header.style.setProperty('pointer-events', 'auto', 'important');
      }
      if (headerInner) {
        headerInner.style.setProperty('height', 'auto', 'important');
        headerInner.style.setProperty('overflow', 'visible', 'important');
        headerInner.style.setProperty('padding', '10px 0', 'important');
        headerInner.style.setProperty('pointer-events', 'auto', 'important');
      }
      
      isFixing = false;
    });
  }

  // 优化触发机制：移除高频轮询，改用 MutationObserver
  window.addEventListener('load', fixMobileMenu);
  window.addEventListener('resize', fixMobileMenu);
  
  // 监听 DOM 变化，只在必要时修复
  const observer = new MutationObserver((mutations) => {
    if (window.innerWidth <= 768) {
        fixMobileMenu();
    }
  });
  
  // 观察 header 区域的变化
  const targetNode = document.querySelector('.header') || document.body;
  observer.observe(targetNode, { attributes: true, childList: true, subtree: true });
  
  // 保留一个低频轮询作为兜底
  setInterval(fixMobileMenu, 2000);
})();
</script>

