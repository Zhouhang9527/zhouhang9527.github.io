/* 控制面板样式 */
#atri-controls {
  position: absolute;
  top: 10px;
  right: 10px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 10px 8px;
  border-radius: 28px;
  pointer-events: auto;
  z-index: 1000;
  isolation: isolate;
}

#atri-controls::before {
  content: '';
  position: absolute;
  top: -2px;
  right: -2px;
  bottom: -2px;
  left: -2px;
  border-radius: 28px;
  background: linear-gradient(180deg,
    rgba(255, 255, 255, 0.26) 0%,
    rgba(255, 255, 255, 0.16) 100%);
  border: 1px solid rgba(255, 255, 255, 0.32);
  backdrop-filter: blur(10px) saturate(135%);
  -webkit-backdrop-filter: blur(10px) saturate(135%);
  box-shadow: 0 8px 28px rgba(91, 155, 213, 0.14);
  pointer-events: none;
  z-index: -1;
}

.atri-control-btn {
  width: 44px !important;
  height: 44px !important;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.35) 0%, 
    rgba(255, 255, 255, 0.15) 100%) !important;
  backdrop-filter: blur(20px) saturate(180%) !important;
  -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
  border: 1px solid rgba(255, 255, 255, 0.5) !important;
  border-radius: 50% !important;
  color: rgba(91, 155, 213, 0.95) !important;
  font-size: 17px !important;
  cursor: pointer !important;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08), 
              0 4px 8px rgba(0, 0, 0, 0.04),
              inset 0 1px 2px rgba(255, 255, 255, 0.8),
              inset 0 -1px 1px rgba(0, 0, 0, 0.05) !important;
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  position: relative !important;
  overflow: hidden !important;
  /* 移动端触摸优化 */
  -webkit-tap-highlight-color: transparent !important;
  touch-action: manipulation !important;
  user-select: none !important;
}

.atri-control-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, transparent, rgba(255, 255, 255, 0.3));
  opacity: 0;
  transition: opacity 0.3s ease;
  border-radius: 50%;
}

.atri-control-btn:hover {
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.45) 0%, 
    rgba(255, 255, 255, 0.25) 100%) !important;
  color: rgba(91, 155, 213, 1) !important;
  transform: translateY(-3px) scale(1.08) !important;
  box-shadow: 0 12px 32px rgba(91, 155, 213, 0.2), 
              0 6px 16px rgba(0, 0, 0, 0.1),
              inset 0 2px 3px rgba(255, 255, 255, 0.9),
              inset 0 -2px 2px rgba(0, 0, 0, 0.06) !important;
  border-color: rgba(255, 255, 255, 0.7) !important;
}

/* 移动端触摸反馈 - 替代 hover */
@media (hover: none) and (pointer: coarse) {
  .atri-control-btn:active {
    background: linear-gradient(135deg, 
      rgba(255, 255, 255, 0.45) 0%, 
      rgba(255, 255, 255, 0.25) 100%) !important;
    transform: scale(0.95) !important;
  }
}

.atri-control-btn:hover::before {
  opacity: 1;
}

.atri-control-btn:active {
  transform: translateY(-1px) scale(0.96) !important;
  box-shadow: 0 4px 12px rgba(91, 155, 213, 0.15), 
              0 2px 6px rgba(0, 0, 0, 0.08),
              inset 0 1px 2px rgba(0, 0, 0, 0.1) !important;
  transition: all 0.1s ease !important;
}

/* 动画效果 */
@keyframes messageSlideIn {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}

@keyframes atriWave {
  0%, 100% {
    transform: rotate(0deg);
  }
  25% {
    transform: rotate(-5deg);
  }
  75% {
    transform: rotate(5deg);
  }
}

/* 欢迎动画 */
#atri-live2d-widget.is-ready #atri-canvas {
  animation: atriEntrance 1s ease-out;
}

@keyframes atriEntrance {
  from {
    opacity: 0;
    transform: translateY(50px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

