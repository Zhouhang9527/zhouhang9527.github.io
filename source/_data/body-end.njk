<!-- ATRI Live2D 增强版 - v2.0 -->
<div id="atri-live2d-widget" style="position: fixed; right: 20px; bottom: 0; z-index: 50;">
  <canvas id="atri-canvas" width="350" height="500"></canvas>
  
  <!-- ATRI 对话框 -->
  <div id="atri-message-box" style="display: none;">
    <div class="atri-message-content"></div>
  </div>
  
  <!-- ATRI 控制面板 -->
  <div id="atri-controls" style="display: flex; pointer-events: auto;">
    <button class="atri-control-btn" id="atri-toggle" title="显示/隐藏">
      <i class="fa fa-eye" style="color: rgba(91, 155, 213, 0.9);"></i>
    </button>
    <button class="atri-control-btn" id="atri-photo" title="截图">
      <i class="fa fa-camera" style="color: rgba(91, 155, 213, 0.9);"></i>
    </button>
    <button class="atri-control-btn" id="atri-volume" title="语音音量">
      <i class="fa fa-volume-up" style="color: rgba(91, 155, 213, 0.9);"></i>
    </button>
    <button class="atri-control-btn" id="atri-talk" title="语音" aria-label="ATRI语音">
      <i class="fa fa-comment" style="color: rgba(91, 155, 213, 0.9);"></i>
    </button>
    <button class="atri-control-btn" id="atri-motion" title="动作/语音" aria-label="ATRI动作语音联动">
      <i class="fa fa-hand-paper" style="color: rgba(91, 155, 213, 0.9);"></i>
    </button>
    <button class="atri-control-btn" id="atri-home" title="复位">
      <i class="fa fa-home" style="color: rgba(91, 155, 213, 0.9);"></i>
    </button>
    <button class="atri-control-btn" id="atri-drag" title="移动">
      <i class="fa fa-arrows-alt" style="color: rgba(91, 155, 213, 0.9);"></i>
    </button>
  </div>
</div>

<!-- Shared scheduler must execute before any optional feature. -->
<script src="{{ ginka_asset('js/ginka-runtime.js') if ginka_asset is defined else config.root ~ 'js/ginka-runtime.js' }}" defer></script>
<script src="{{ ginka_asset('js/ginka-atri-loader.js') if ginka_asset is defined else config.root ~ 'js/ginka-atri-loader.js' }}" defer></script>











<!-- 自定义右键菜单 -->
<div id="custom-context-menu">
  <div class="context-menu-item" data-action="back">
    <i class="fa fa-arrow-left"></i>
    <span>后退</span>
  </div>
  <div class="context-menu-item" data-action="forward">
    <i class="fa fa-arrow-right"></i>
    <span>前进</span>
  </div>
  <div class="context-menu-item" data-action="refresh">
    <i class="fa fa-sync-alt"></i>
    <span>刷新页面</span>
  </div>
  <div class="context-menu-divider"></div>
  <div class="context-menu-item" data-action="home">
    <i class="fa fa-home"></i>
    <span>返回首页</span>
  </div>
  <div class="context-menu-item" data-action="top">
    <i class="fa fa-arrow-up"></i>
    <span>回到顶部</span>
  </div>
  <div class="context-menu-divider"></div>
  <div class="context-menu-item" data-action="atri">
    <i class="fa fa-heart"></i>
    <span>和 ATRI 打招呼</span>
  </div>
  <div class="context-menu-item" data-action="music">
    <i class="fa fa-music"></i>
    <span>切换音乐播放</span>
  </div>
</div>

<script src="{{ ginka_asset('js/ginka-ui-shell.js') if ginka_asset is defined else config.root ~ 'js/ginka-ui-shell.js' }}" defer></script>
<script src="{{ ginka_asset('js/ginka-controls.js') if ginka_asset is defined else config.root ~ 'js/ginka-controls.js' }}" defer></script>
<script src="{{ ginka_asset('js/ginka-music.js') if ginka_asset is defined else config.root ~ 'js/ginka-music.js' }}" defer></script>

