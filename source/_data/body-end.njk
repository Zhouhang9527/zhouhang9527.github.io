<!-- PJAX 支持 - 跨页面音乐持续播放 -->
<script>
(function() {
  function playPjaxVoiceHint() {
    const atri = window.ATRI;
    if (!atri) return;
    const cooldownKey = '__ginkaAtriUiVoiceCooldownAt';
    const now = Date.now();
    const last = Number(window[cooldownKey] || 0);
    if (now - last < 5000) return;
    window[cooldownKey] = now;

    const plan = [
      { category: 'welcome', options: { duration: 2000, disableMotion: true } },
      { category: 'talk', options: { duration: 2000, disableMotion: true } },
      { category: 'click', options: { duration: 1600, disableMotion: true, showSubtitle: false } }
    ];

    if (typeof atri.playVoiceByPriority === 'function') {
      try {
        atri.playVoiceByPriority(plan);
        return;
      } catch (_) {}
    }

    if (typeof atri.playVoice !== 'function') return;
    for (const item of plan) {
      try {
        if (atri.playVoice(item.category, item.options || {})) {
          return;
        }
      } catch (_) {}
    }
  }

  // PJAX 页面加载完成后重新初始化 ATRI（但不重新初始化音乐播放器）
  document.addEventListener('pjax:complete', function() {
    console.log('[PJAX] 页面切换完成');
    
    // 重新初始化 ATRI Live2D（如果需要）
    if (window.ATRI) {
      playPjaxVoiceHint();
    }
    
    // 音乐播放器会自动保持状态，无需重新初始化
    const audio = document.getElementById('bg-music');
    if (audio) {
      console.log('[PJAX] 音乐播放器状态保持');
    }
  });
  
  // PJAX 发送请求前
  document.addEventListener('pjax:send', function() {
    console.log('[PJAX] 开始加载新页面...');
  });
})();
</script>

