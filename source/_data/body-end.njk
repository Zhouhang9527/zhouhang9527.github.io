{# ATRI shell is persistent across PJAX; the loader exposes it only on the real home route with .journal-hero. #}
<div id="atri-launcher-shell" class="atri-launcher-shell" hidden>
  <button id="atri-launcher" class="atri-launcher__badge" type="button" aria-label="打开看板娘" aria-expanded="false" aria-controls="atri-live2d-widget" data-atri-script="{{ ginka_asset('js/ginka-atri.js') if ginka_asset is defined else config.root ~ 'js/ginka-atri.js' }}">
    <img src="{{ ginka_asset('images/ginka/butterfly.png') if ginka_asset is defined else config.root ~ 'images/ginka/butterfly.png' }}" alt="" width="36" height="36" decoding="async">
  </button>
  <span id="atri-launcher-status" class="atri-launcher__status" role="status"></span>
</div>

<div id="atri-live2d-widget" role="region" aria-label="ATRI 看板娘" hidden>
  <canvas id="atri-canvas" width="220" height="314" aria-label="ATRI 看板娘"></canvas>
  <div id="atri-message-box" role="status" aria-live="polite" style="display:none">
    <div class="atri-message-content"></div>
  </div>
  <div id="atri-controls" aria-label="ATRI 控制">
    <button class="atri-control-btn" id="atri-toggle" type="button" title="收起看板娘" aria-label="收起看板娘">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="m4 4 8 8m0-8-8 8"/></svg>
    </button>
  </div>
</div>

<script src="{{ ginka_asset('js/ginka-runtime.js') if ginka_asset is defined else config.root ~ 'js/ginka-runtime.js' }}" defer></script>
<script src="{{ ginka_asset('js/ginka-reading.js') if ginka_asset is defined else config.root ~ 'js/ginka-reading.js' }}" defer></script>
<script src="{{ ginka_asset('js/ginka-atri-loader.js') if ginka_asset is defined else config.root ~ 'js/ginka-atri-loader.js' }}" defer></script>
<script src="{{ ginka_asset('js/ginka-ui-shell.js') if ginka_asset is defined else config.root ~ 'js/ginka-ui-shell.js' }}" defer></script>
<script src="{{ ginka_asset('js/ginka-theme.js') if ginka_asset is defined else config.root ~ 'js/ginka-theme.js' }}" defer></script>
<script src="{{ ginka_asset('js/ginka-controls.js') if ginka_asset is defined else config.root ~ 'js/ginka-controls.js' }}" defer></script>
<script src="{{ ginka_asset('js/vendor/lenis.min.js') if ginka_asset is defined else config.root ~ 'js/vendor/lenis.min.js' }}" defer></script>
<script src="{{ ginka_asset('js/ginka-motion.js') if ginka_asset is defined else config.root ~ 'js/ginka-motion.js' }}" defer></script>
<script src="{{ ginka_asset('js/ginka-music.js') if ginka_asset is defined else config.root ~ 'js/ginka-music.js' }}" defer></script>
<script src="{{ ginka_asset('js/ginka-performance-monitor.js') if ginka_asset is defined else config.root ~ 'js/ginka-performance-monitor.js' }}" defer></script>

{# Keep the native context menu actions; the ATRI option was removed to avoid a second loader path. #}
<div id="custom-context-menu">
  <div class="context-menu-item" data-action="back"><i class="fa fa-arrow-left"></i><span>后退</span></div>
  <div class="context-menu-item" data-action="forward"><i class="fa fa-arrow-right"></i><span>前进</span></div>
  <div class="context-menu-item" data-action="refresh"><i class="fa fa-sync-alt"></i><span>刷新页面</span></div>
  <div class="context-menu-divider"></div>
  <div class="context-menu-item" data-action="home"><i class="fa fa-home"></i><span>返回首页</span></div>
  <div class="context-menu-item" data-action="top"><i class="fa fa-arrow-up"></i><span>回到顶部</span></div>
  <div class="context-menu-divider"></div>
  <div class="context-menu-item" data-action="music"><i class="fa fa-music"></i><span>切换音乐播放</span></div>
</div>
