<script>
(function() {
  const homeUrl = (window.CONFIG && window.CONFIG.root) ? window.CONFIG.root : '/';

  const goHome = () => {
    // 优先使用 NexT 的 PJAX（切换更连贯、音乐不中断）
    try {
      if (window.pjax && typeof window.pjax.loadUrl === 'function') {
        window.pjax.loadUrl(homeUrl);
        return;
      }
    } catch (_) {}
    window.location.href = homeUrl;
  };

  document.addEventListener('click', (e) => {
    const a = e.target && e.target.closest ? e.target.closest('a') : null;
    if (!a) return;

    // NexT 顶部菜单“首页”
    if (a.matches('.menu-item-home > a')) {
      e.preventDefault();
      goHome();
      return;
    }

    // 左上角品牌
    if (a.matches('a.brand[rel="start"]')) {
      e.preventDefault();
      goHome();
      return;
    }
  }, { capture: true });
})();
</script>

