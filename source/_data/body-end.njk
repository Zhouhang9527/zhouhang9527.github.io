  width: 0;
  height: 0;
  border-left: 8px solid transparent;
  border-right: 8px solid transparent;
  border-top: 8px solid rgba(255, 255, 255, 0.78);
  filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.1));
