<!-- 背景音乐播放器 - 梦浮桥 -->
<div id="music-player" style="position: fixed; bottom: 20px; left: 20px; z-index: 998;">
  <div class="music-container">
    <button id="music-toggle" class="music-btn" title="播放/暂停音乐">
      <i class="fas fa-music"></i>
    </button>
    <div class="music-info" id="music-info" style="display: none;">
      <span class="music-title">梦浮桥 - ATRI 主题曲</span>
      <div class="music-progress">
        <div class="music-progress-bar" id="music-progress-bar"></div>
      </div>
    </div>
  </div>
  <audio id="bg-music" loop preload="metadata">
    <source src="/music/yumefuribashi.mp3" type="audio/mpeg">
    <source src="/music/yumefuribashi.ogg" type="audio/ogg">
  </audio>
</div>

<style>
/* 音乐播放器样式 */
.music-container {
  display: flex;
  align-items: center;
  gap: 12px;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  padding: 8px 12px;
  border-radius: 50px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

@media (prefers-color-scheme: dark) {
  .music-container {
    background: rgba(30, 30, 30, 0.95);
    box-shadow: 0 4px 15px rgba(255, 255, 255, 0.05);
  }
}

.music-container:hover {
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
  transform: translateY(-2px);
}

.music-btn {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: none;
  background: linear-gradient(135deg, #5b9bd5 0%, #7eb8e6 100%);
  color: white;
  font-size: 16px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.music-btn:hover {
  transform: scale(1.1);
  box-shadow: 0 4px 12px rgba(91, 155, 213, 0.4);
}

.music-btn:active {
  transform: scale(0.95);
}

.music-btn.playing {
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(91, 155, 213, 0.7);
  }
  50% {
    box-shadow: 0 0 0 8px rgba(91, 155, 213, 0);
  }
}

.music-info {
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 180px;
  animation: slideIn 0.3s ease-out;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(-10px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.music-title {
  font-size: 13px;
  color: #333;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

@media (prefers-color-scheme: dark) {
  .music-title {
    color: #e0e0e0;
  }
}

.music-progress {
  width: 100%;
  height: 4px;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 2px;
  overflow: hidden;
}

@media (prefers-color-scheme: dark) {
  .music-progress {
    background: rgba(255, 255, 255, 0.1);
  }
}

.music-progress-bar {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, #5b9bd5 0%, #7eb8e6 100%);
  transition: width 0.3s ease;
  border-radius: 2px;
}

/* 移动端适配 */
@media (max-width: 768px) {
  #music-player {
    left: 10px;
    bottom: 80px; /* 避免与ATRI重叠 */
  }
  
  .music-container {
    padding: 6px 10px;
  }
  
  .music-btn {
    width: 36px;
    height: 36px;
    font-size: 14px;
  }
  
  .music-info {
    min-width: 140px;
  }
  
  .music-title {
    font-size: 12px;
  }
}

/* 超小屏幕隐藏信息只保留按钮 */
@media (max-width: 480px) {
  .music-info {
    display: none !important;
  }
}
</style>

<script>
(function() {
  'use strict';
  
  const musicPlayer = {
    audio: null,
    toggleBtn: null,
    progressBar: null,
    infoDiv: null,
    isPlaying: false,
    
    init() {
      this.audio = document.getElementById('bg-music');
      this.toggleBtn = document.getElementById('music-toggle');
      this.progressBar = document.getElementById('music-progress-bar');
      this.infoDiv = document.getElementById('music-info');
      
      if (!this.audio || !this.toggleBtn) {
        console.warn('[Music] 音乐播放器元素未找到');
        return;
      }
      
      // 设置音量
      this.audio.volume = 0.3;
      
      // 绑定事件
      this.toggleBtn.addEventListener('click', () => this.toggle());
      this.audio.addEventListener('timeupdate', () => this.updateProgress());
      this.audio.addEventListener('ended', () => this.onEnded());
      this.audio.addEventListener('error', (e) => this.onError(e));
      
      // 恢复上次的播放状态
      const savedState = localStorage.getItem('music_playing');
      if (savedState === 'true') {
        // 延迟自动播放（某些浏览器需要用户交互）
        setTimeout(() => {
          this.play().catch(() => {
            console.log('[Music] 自动播放被阻止，等待用户点击');
          });
        }, 1000);
      }
      
      console.log('[Music] 音乐播放器初始化完成');
    },
    
    async toggle() {
      if (this.isPlaying) {
        this.pause();
      } else {
        await this.play();
      }
    },
    
    async play() {
      try {
        await this.audio.play();
        this.isPlaying = true;
        this.toggleBtn.innerHTML = '<i class="fas fa-pause"></i>';
        this.toggleBtn.classList.add('playing');
        this.infoDiv.style.display = 'flex';
        localStorage.setItem('music_playing', 'true');
        console.log('[Music] 开始播放');
      } catch (error) {
        console.error('[Music] 播放失败:', error);
        throw error;
      }
    },
    
    pause() {
      this.audio.pause();
      this.isPlaying = false;
      this.toggleBtn.innerHTML = '<i class="fas fa-music"></i>';
      this.toggleBtn.classList.remove('playing');
      localStorage.setItem('music_playing', 'false');
      console.log('[Music] 暂停播放');
    },
    
    updateProgress() {
      if (this.audio.duration) {
        const progress = (this.audio.currentTime / this.audio.duration) * 100;
        this.progressBar.style.width = progress + '%';
      }
    },
    
    onEnded() {
      // 循环播放，但这里不需要因为audio标签已设置loop
      console.log('[Music] 播放结束，自动循环');
    },
    
    onError(error) {
      console.error('[Music] 加载失败:', error);
      this.toggleBtn.innerHTML = '<i class="fas fa-exclamation-triangle"></i>';
      this.toggleBtn.title = '音乐加载失败';
    }
  };
  
  // 页面加载完成后初始化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => musicPlayer.init());
  } else {
    musicPlayer.init();
  }
  
  // 暴露到全局（用于调试）
  window.MusicPlayer = musicPlayer;
})();
</script>
