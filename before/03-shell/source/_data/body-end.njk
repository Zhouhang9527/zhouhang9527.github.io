<!-- ATRI Live2D 增强版 - v2.0 -->
<div id="atri-live2d-widget" role="region" aria-label="ATRI 看板娘" style="position: fixed; right: 20px; bottom: 64px; z-index: 50;">
  <canvas id="atri-canvas" width="350" height="500"></canvas>
  
  <!-- ATRI 对话框 -->
  <div id="atri-message-box" role="status" aria-live="polite" style="display: none;">
    <div class="atri-message-content"></div>
  </div>
  
  <!-- ATRI 控制面板 -->
  <div id="atri-controls" aria-label="ATRI 控制面板">
    <button class="atri-control-btn" id="atri-toggle" title="收起看板娘" aria-label="收起看板娘"><i class="fa fa-eye"></i><span>收起</span></button>
    <button class="atri-control-btn" id="atri-photo" title="截图" aria-label="截图"><i class="fa fa-camera"></i><span>截图</span></button>
    <button class="atri-control-btn" id="atri-volume" title="语音音量" aria-label="语音音量"><i class="fa fa-volume-up"></i><span>音量</span></button>
    <button class="atri-control-btn" id="atri-talk" title="语音" aria-label="ATRI语音"><i class="fa fa-comment"></i><span>对话</span></button>
    <button class="atri-control-btn" id="atri-motion" title="动作/语音" aria-label="ATRI动作语音联动"><i class="fa fa-hand-paper"></i><span>动作</span></button>
    <button class="atri-control-btn" id="atri-home" title="复位" aria-label="复位"><i class="fa fa-home"></i><span>复位</span></button>
    <button class="atri-control-btn" id="atri-drag" title="移动" aria-label="移动"><i class="fa fa-arrows-alt"></i><span>移动</span></button>
  </div>
</div>

<!-- Shared scheduler must execute before any optional feature. -->
<script src="{{ ginka_asset('js/ginka-runtime.js') if ginka_asset is defined else config.root ~ 'js/ginka-runtime.js' }}" defer></script>
<script src="{{ ginka_asset('js/ginka-reading.js') if ginka_asset is defined else config.root ~ 'js/ginka-reading.js' }}" defer></script>
<script src="{{ ginka_asset('js/ginka-atri-loader.js') if ginka_asset is defined else config.root ~ 'js/ginka-atri-loader.js' }}" defer></script>











<!-- 自定义右键菜单 -->
<div id="custom-context-menu">
  <div class="context-menu-item" data-action="back">
    <i class="fa fa-arrow-left"></i>
    <span>后退</span>
  </div>
  <div class="context-menu-item" data-action="forward">
    <i class="fa fa-arrow-right"></i>
    <span>前进</span>
  </div>
  <div class="context-menu-item" data-action="refresh">
    <i class="fa fa-sync-alt"></i>
    <span>刷新页面</span>
  </div>
  <div class="context-menu-divider"></div>
  <div class="context-menu-item" data-action="home">
    <i class="fa fa-home"></i>
    <span>返回首页</span>
  </div>
  <div class="context-menu-item" data-action="top">
    <i class="fa fa-arrow-up"></i>
    <span>回到顶部</span>
  </div>
  <div class="context-menu-divider"></div>
  <div class="context-menu-item" data-action="atri">
    <i class="fa fa-heart"></i>
    <span>和 ATRI 打招呼</span>
  </div>
  <div class="context-menu-item" data-action="music">
    <i class="fa fa-music"></i>
    <span>切换音乐播放</span>
  </div>
</div>

<script src="{{ ginka_asset('js/ginka-ui-shell.js') if ginka_asset is defined else config.root ~ 'js/ginka-ui-shell.js' }}" defer></script>
<script src="{{ ginka_asset('js/ginka-controls.js') if ginka_asset is defined else config.root ~ 'js/ginka-controls.js' }}" defer></script>
<script src="{{ ginka_asset('js/ginka-music.js') if ginka_asset is defined else config.root ~ 'js/ginka-music.js' }}" defer></script>

