{# Custom head injection #}

{# 关键 CSS 内联 - 首屏渲染优化 #}
<style>
:root{--primary-color:#37c6c0;--text-color:#333;--bg-color:#fff}*{box-sizing:border-box;margin:0;padding:0}html{font-size:16px;line-height:1.6;-webkit-text-size-adjust:100%}body{font-family:"Noto Serif SC Variable",serif;color:var(--text-color);background:var(--bg-color);overflow-x:hidden}.container{max-width:1200px;margin:0 auto;padding:0 20px}.header{background:#fff;box-shadow:0 2px 4px rgba(0,0,0,.08);position:sticky;top:0;z-index:1000}.header-inner{display:flex;align-items:center;justify-content:space-between;padding:1rem 0}.site-brand{display:flex;align-items:center;gap:1rem}.site-title{font-size:1.5rem;font-weight:600;color:var(--text-color);text-decoration:none}.menu{display:flex;list-style:none;gap:1.5rem}.menu-item a{color:var(--text-color);text-decoration:none;transition:color .2s}.menu-item a:hover{color:var(--primary-color)}.main{min-height:50vh;padding:2rem 0}.content{opacity:1}.loading{position:fixed;top:0;left:0;right:0;bottom:0;background:#fff;display:flex;align-items:center;justify-content:center;z-index:9999}.preloader{width:50px;height:50px;border:3px solid #f3f3f3;border-top:3px solid var(--primary-color);border-radius:50%;animation:spin 1s linear infinite}@keyframes spin{0%{transform:rotate(0deg)}100%{transform:rotate(360deg)}}@media (max-width:768px){.menu{display:none}.site-title{font-size:1.2rem}}
</style>

{# DNS 预解析 - 外部资源加速 #}
<link rel="dns-prefetch" href="//meting.mm9527.top">
<link rel="dns-prefetch" href="//hm.baidu.com">
<link rel="dns-prefetch" href="//cdn.jsdelivr.net">

{# 预连接 - 建立早期连接 #}
<link rel="preconnect" href="https://meting.mm9527.top" crossorigin>
<link rel="preconnect" href="https://hm.baidu.com">

{# 字体 CSS - 保持同步加载以避免 FOIT #}
<link rel="stylesheet" href="/vendor/fonts/noto-serif-sc/wght.css">
<link rel="stylesheet" href="/vendor/fonts/jetbrains-mono/wght.css">

{# 完整 CSS - 异步加载以加速首屏渲染 #}
<link rel="preload" href="{{ ginka_asset('css/ginka-editorial.css') if ginka_asset is defined else config.root ~ 'css/ginka-editorial.css' }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<link rel="preload" href="{{ ginka_asset('css/ginka-pages.css') if ginka_asset is defined else config.root ~ 'css/ginka-pages.css' }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<link rel="preload" href="{{ ginka_asset('css/ginka-reading.css') if ginka_asset is defined else config.root ~ 'css/ginka-reading.css' }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<link rel="preload" href="{{ ginka_asset('css/ginka-runtime.css') if ginka_asset is defined else config.root ~ 'css/ginka-runtime.css' }}" as="style" onload="this.onload=null;this.rel='stylesheet'">

{# 无 JS 降级方案 #}
<noscript>
  <link rel="stylesheet" href="{{ ginka_asset('css/ginka-editorial.css') if ginka_asset is defined else config.root ~ 'css/ginka-editorial.css' }}">
  <link rel="stylesheet" href="{{ ginka_asset('css/ginka-pages.css') if ginka_asset is defined else config.root ~ 'css/ginka-pages.css' }}">
  <link rel="stylesheet" href="{{ ginka_asset('css/ginka-reading.css') if ginka_asset is defined else config.root ~ 'css/ginka-reading.css' }}">
  <link rel="stylesheet" href="{{ ginka_asset('css/ginka-runtime.css') if ginka_asset is defined else config.root ~ 'css/ginka-runtime.css' }}">
</noscript>
<link rel="preload" href="{{ config.root }}images/ginka/header-logo.png" as="image">
<link rel="manifest" href="{{ config.root }}manifest.webmanifest">
<script defer>
  if ('serviceWorker' in navigator) window.addEventListener('load', () => navigator.serviceWorker.register('{{ config.root }}sw.js').catch(() => {}));
</script>

<!-- SEO 和性能优化增强 -->

<!-- 预加载关键资源 -->
<link rel="preload" href="/js/next-boot.js" as="script">
{% if config.ginka_music and config.ginka_music.online and config.ginka_music.online.enabled %}
<link rel="preconnect" href="{{ config.ginka_music.online.api_base }}" crossorigin>
{% endif %}

